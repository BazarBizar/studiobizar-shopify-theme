# Studio Bizar — environment template. Copy to `.env` and fill in.
# `.env*` is gitignored; never commit real values.

# ---------------------------------------------------------------------------
# Shopify — store and API versions
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07

# Storefront API. Public-read catalogue and content, used by every public page.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API. Powerful — see the scope list in README.md before generating it.
# Read by lib/admin/env.ts (admin panel) and lib/shopify/admin.ts (inquiry write).
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Customer Account API client id, for storefront customer sign-in.
# Optional: without it /account shows a "not connected" state instead of failing.
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=

# ---------------------------------------------------------------------------
# Admin panel (/admin) — all three are required for the panel to start
# Generate with:
#   npx tsx --conditions=react-server scripts/admin-credentials.ts
# ---------------------------------------------------------------------------
# Who may sign in. Comma-separated, compared lowercase. Removing an address
# locks that person out on their next request, not when their session expires.
ADMIN_ALLOWED_EMAILS=

# scrypt:N:r:p:<salt base64>:<hash base64>. Shared by all staff; the allowlist
# above is what distinguishes them. Colon-separated, not the usual $-separated
# crypt format: Next expands $VAR inside .env values and would eat it.
ADMIN_PASSWORD_HASH=

# Signs the staff session cookie. At least 32 characters.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Storefront integrations — all optional. An empty value means "not configured"
# and is treated the same as being absent.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_NOTIFY_EMAIL=
BEHOLD_FEED_ID=

# Shared secret for POST /api/revalidate. Required in production, or the route
# refuses every request.
REVALIDATE_SECRET=

# Public URL of this storefront, for the admin panel's "View on store" links.
# Shopify cannot supply this: a headless store's primaryDomain is still the
# Shopify-hosted domain, not the Next app serving the catalogue.
STOREFRONT_URL=https://www.example.com
