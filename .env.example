# Studio Bizar — environment template. Copy to `.env` and fill in.
# `.env*` is gitignored; never commit real values.

# ---------------------------------------------------------------------------
# Shopify — store and API versions
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07

# Storefront API. Public-read catalogue and content, used by every public page.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API. Powerful — see the scope list in README.md before generating it.
# Read by lib/admin/env.ts (admin panel) and lib/shopify/admin.ts (inquiry write).
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Customer Account API client id, for storefront customer sign-in.
# Optional: without it /account shows a "not connected" state instead of failing.
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=

# ---------------------------------------------------------------------------
# Admin panel (/admin) — all three are required for the panel to start
# Generate with:
#   npx tsx --conditions=react-server scripts/admin-credentials.ts
# ---------------------------------------------------------------------------
# The OWNERS. Comma-separated, compared lowercase. They always keep access and
# cannot be removed from the panel; everyone else is added and removed in the
# panel (Settings → Staff & sign-in), each with their own password.
ADMIN_ALLOWED_EMAILS=

# scrypt:N:r:p:<salt base64>:<hash base64>. The owners' password until an owner
# sets their own under Staff & sign-in — from then on only theirs works (forgot
# it? delete the shop metafield studio_admin.staff_accounts in Shopify and this
# one works again). Colon-separated, not the usual $-separated crypt format:
# Next expands $VAR inside .env values and would eat it.
ADMIN_PASSWORD_HASH=

# Signs the staff session cookie. At least 32 characters.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Storefront integrations — all optional. An empty value means "not configured"
# and is treated the same as being absent.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Fallback only. Staff notification recipients live in the `email_notification`
# metaobject (docs/modules/email-notifications.md); this address is used when that
# has no entries or Shopify cannot be reached. Comma-separated.
INQUIRY_NOTIFY_EMAIL=
# Fallback only. The Instagram feed is set in the panel: Site-wide → Site
# settings → Instagram feed. A Behold feed id, or https://feeds.behold.so/<id>.
BEHOLD_FEED_ID=

# Shared secret for POST /api/revalidate. Required in production, or the route
# refuses every request. Send it as the `x-revalidate-secret` header (the
# `?secret=` query form still works, but ends up in access logs).
REVALIDATE_SECRET=

# Rate limits shared by every instance (login, admin writes, the public forms) —
# an Upstash Redis REST endpoint. Vercel KV's KV_REST_API_URL / KV_REST_API_TOKEN
# work too. Without them the limits are counted per instance: fine on one server,
# multiplied on a host that runs several (any serverless platform). See
# lib/admin/rate-limit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL of this storefront, for the admin panel's "View on store" links.
# Shopify cannot supply this: a headless store's primaryDomain is still the
# Shopify-hosted domain, not the Next app serving the catalogue.
STOREFRONT_URL=https://www.example.com
