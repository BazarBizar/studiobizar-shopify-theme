# Shop domain. Bare handle or full myshopify domain both work.
SHOPIFY_STORE_DOMAIN=studio-bizar-be.myshopify.com

# Admin API access token from a custom app (Settings > Apps and sales channels
# > Develop apps > your app > API credentials). Starts with shpat_.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version. Quarterly releases: 2025-10, 2026-01, 2026-04, 2026-07 ...
SHOPIFY_API_VERSION=2026-07
