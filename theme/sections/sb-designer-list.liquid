{% comment %}
  app/(storefront)/designers/page.tsx — the 4-up designer grid on mocha.

  A SECTION ON A PAGE, not a template of its own. `/designers` is a Shopify page
  in this store, and the metaobjects are read through `shop.metaobjects` — which
  is the whole reason the Liquid port needs no GraphQL: the definition has
  storefront access, so Liquid can walk it directly.

  ORDER. `shop.metaobjects.designer.values` comes back in Shopify's own order and
  Liquid cannot sort on a nested field, so the `sort_order` integer each entry
  carries is used with the `sort` filter — which does work on a flat key. Entries
  without one sort as blank and land first, so the field is worth filling in.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture

  assign designers = shop.metaobjects.designer.values | sort: 'sort_order'
  assign shown = designers

  if s.limit > 0
    assign shown = designers | slice: 0, s.limit
  endif

  assign heading = s.heading
  if heading == blank
    assign heading = 'designer.title' | t
  endif
-%}

<section
  data-surface="{{ s.surface }}"
  class="bg-background text-foreground"
  {{ section.shopify_attributes }}
>
  <div class="sb-container pt-12 pb-section {{ rhythm_class }}">
    <header class="max-w-[46rem]">
      <h1 class="text-h1">{{ heading }}</h1>
      {%- if s.intro != blank -%}
        <div class="sb-prose mt-6">{{ s.intro }}</div>
      {%- endif -%}
    </header>

    {%- if shown.size == 0 -%}
      <p class="text-body mt-16 text-muted">{{ 'designer.none' | t }}</p>
    {%- else -%}
      <ul class="sb-grid-4 mt-12 gap-y-12">
        {%- for entry in shown -%}
          {%- liquid
            comment
              The first row is above the fold on every viewport the designs cover.
            endcomment
            assign eager = false
            if forloop.index0 < 4
              assign eager = true
            endif
          -%}
          <li>{%- render 'sb-designer-card', designer: entry, priority: eager -%}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Designer list",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads every `designer` metaobject, ordered by its sort_order field. Entries are managed in the admin panel, not here."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Designers"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum shown",
      "info": "0 shows all of them.",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 0
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Ground",
      "info": "Deep mocha in the design.",
      "options": [
        { "value": "light", "label": "Earth" },
        { "value": "dark", "label": "Dark wood" },
        { "value": "olive", "label": "Black olive" },
        { "value": "blue", "label": "Charcoal blue" },
        { "value": "mocha", "label": "Deep mocha" },
        { "value": "black", "label": "Off black" }
      ],
      "default": "mocha"
    },
    {
      "type": "select",
      "id": "rhythm",
      "label": "Vertical space",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "xs", "label": "Extra tight" },
        { "value": "sm", "label": "Tight" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Loose" },
        { "value": "xl", "label": "Extra loose" }
      ],
      "default": "theme"
    }
  ],
  "presets": [
    {
      "name": "Designer list"
    }
  ]
}
{% endschema %}
