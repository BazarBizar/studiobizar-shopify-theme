          "label": "XL"
        }
      ],
      "default": "md",
      "info": "Only when the pop-up has Column blocks."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Own colour",
      "info": "Empty: the site's light background."
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text colour"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Line around it",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0: no line."
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Line",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Line colour",
      "info": "Empty: the text colour."
    },
    {
      "type": "select",
      "id": "shadow",
      "label": "Shadow",
      "options": [
