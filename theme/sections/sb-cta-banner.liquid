{% comment %}
  Call to action — the page builder's `cta_banner`
  (components/sections/landing/cta-banner.tsx). One message and its buttons:
  centred or split on the band's own surface, or on a photograph.

  The schema below is GENERATED from lib/page-builder/sections-landing.ts by
  `yarn liquid:schemas`; change the section there, not here.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  case s.width
    when 'narrow'
      assign width_class = 'max-w-[36rem]'
    when 'full'
      assign width_class = 'max-w-none'
    else
      assign width_class = 'max-w-[52rem]'
  endcase

  if s.tone == 'dark'
    assign tone_surface = 'light'
  else
    assign tone_surface = 'black'
  endif

  capture heading_class
    render 'sb-heading-class', size: s.heading_size
  endcapture
-%}

<div
  {% if s.surface != 'inherit' %}data-surface="{{ s.surface }}"{% endif %}
  class="{% if s.surface != 'inherit' %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  {% render 'sb-section-style', settings: s %}
  {{ section.shopify_attributes }}
>
  {%- case s.layout -%}
    {%- when 'split' -%}
      <div class="sb-container py-section">
        <div class="border-border grid gap-8 border-t pt-10 lg:grid-cols-[3fr_2fr] lg:items-end lg:gap-16">
          <div class="{{ width_class }}">
            {%- if s.eyebrow != blank -%}
              <p class="text-tertiary mb-3 uppercase tracking-[0.08em] opacity-80">{{ s.eyebrow }}</p>
            {%- endif -%}
            {%- if s.title != blank -%}
              <h2 class="{{ heading_class }}">{{ s.title }}</h2>
            {%- endif -%}
            {%- if s.body != blank -%}
              <p class="text-body text-muted mt-5 whitespace-pre-line">{{ s.body | escape }}</p>
            {%- endif -%}
          </div>
          <div data-sb-buttons class="flex flex-wrap gap-3 lg:justify-end">
            {%- if s.primary_label != blank and s.primary_url != blank -%}
              {%- render 'sb-button', label: s.primary_label, href: s.primary_url, variant: s.primary_style -%}
            {%- endif -%}
            {%- if s.secondary_label != blank and s.secondary_url != blank -%}
              {%- render 'sb-button', label: s.secondary_label, href: s.secondary_url, variant: s.secondary_style -%}
            {%- endif -%}
          </div>
        </div>
      </div>

    {%- when 'image' -%}
      <div class="bg-off-black relative isolate overflow-hidden">
        {%- render 'sb-cover-image', image: s.image -%}
        {%- if s.image != blank and s.overlay > 0 -%}
          <div aria-hidden="true" class="bg-off-black absolute inset-0" style="opacity: {{ s.overlay | divided_by: 100.0 }};"></div>
        {%- endif -%}
        <div data-surface="{{ tone_surface }}" class="sb-container py-section-lg text-foreground relative flex justify-center">
          {%- render 'sb-landing-copy',
            eyebrow: s.eyebrow,
            heading: s.title,
            body: s.body,
            heading_size: s.heading_size,
            primary_label: s.primary_label,
            primary_url: s.primary_url,
            primary_style: s.primary_style,
            secondary_label: s.secondary_label,
            secondary_url: s.secondary_url,
            secondary_style: s.secondary_style,
            align: 'center',
            class: width_class
          -%}
        </div>
      </div>

    {%- else -%}
      <div class="sb-container py-section flex justify-center">
        {%- render 'sb-landing-copy',
          eyebrow: s.eyebrow,
          heading: s.title,
          body: s.body,
          heading_size: s.heading_size,
          primary_label: s.primary_label,
          primary_url: s.primary_url,
          primary_style: s.primary_style,
          secondary_label: s.secondary_label,
          secondary_url: s.secondary_url,
          secondary_style: s.secondary_style,
          align: 'center',
          class: width_class
        -%}
      </div>
  {%- endcase -%}
</div>

