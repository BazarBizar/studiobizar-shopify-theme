{% comment %}
  Custom section — the page builder's `custom_section`
  (components/sections/landing/custom-section.tsx). The editor's own blocks:
  headings, text, photos, buttons, icons, cards, video, lists, quotes, fold-outs,
  lines, space and products, stacked — or in columns, where a Column block starts
  one and the blocks after it (up to the next Column) sit in it. Blocks before the
  first Column fill the width.

  Every choice is a data attribute drawn by the shared rules in
  styles/sb-blocks.css (inside sb-theme.css), exactly as the Next build writes
  them. Not here yet (Next only, `nextOnly`): a block's own Typography / Button look.

  The schema below is GENERATED from lib/page-builder/sections-custom.ts by
  `yarn liquid:schemas`; change the section there, not here.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  case s.width
    when 'medium'
      assign width_class = 'mx-auto max-w-[64rem]'
    when 'narrow'
      assign width_class = 'mx-auto max-w-[46rem]'
    else
      assign width_class = ''
  endcase
-%}

<div
  {% if s.surface != 'inherit' %}data-surface="{{ s.surface }}"{% endif %}
  class="{% if s.surface != 'inherit' %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  {% render 'sb-section-style', settings: s %}
  {{ section.shopify_attributes }}
>
  {%- if section.blocks.size > 0 -%}
    <div class="py-section{% if s.width != 'full' %} sb-container{% endif %}">
      <div class="sb-blocks {{ width_class }}" data-align="{{ s.align }}" data-gap="{{ s.gap }}" data-cgap="{{ s.column_gap }}">
        {%- comment -%}
          One pass per column: a Column block, or — when the first block is not one —
          the column the leading blocks fill. Each then draws the blocks after it, up
          to the next Column, so every <div> it opens it also closes.
        {%- endcomment -%}
        {%- for column in section.blocks -%}
          {%- if column.type != 'column' and forloop.first == false -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign c = column.settings
            assign column_css = ''
            if column.type == 'column'
              assign start = forloop.index
              if c.width_tablet == 'same'
                assign tablet = c.width
              else
                assign tablet = c.width_tablet
              endif
              if c.background != blank
                assign column_css = column_css | append: 'background-color:' | append: c.background | append: ';'
              endif
              if c.border
                assign column_css = column_css | append: 'border:1px solid var(--sb-border);'
              endif
              if c.radius > 0
                assign column_css = column_css | append: 'border-radius:' | append: c.radius | append: 'px;overflow:clip;'
              endif
            else
              assign start = 0
            endif
          -%}
          {%- capture column_attrs -%}
            {%- if column.type == 'column' -%}
              data-wd="{{ c.width }}" data-wt="{{ tablet }}" data-wm="{{ c.width_mobile }}" data-pos="{{ c.position }}" data-pad="{{ c.padding }}"
              {%- if c.mobile_first %} data-first{% endif %}
              {%- if c.hide_on == 'mobile' or c.hide_on == 'desktop' %} data-hide="{{ c.hide_on }}"{% endif %}
              {%- if column_css != blank %} style="{{ column_css }}"{% endif %} {{ column.shopify_attributes }}
            {%- else -%}
              data-wd="100" data-wt="100" data-wm="100"
            {%- endif -%}
          {%- endcapture -%}
          <div class="sb-bk-col" {{ column_attrs }}>
          {%- for block in section.blocks offset: start -%}
          {%- if block.type == 'column' -%}{%- break -%}{%- endif -%}
          {%- assign b = block.settings -%}

          {%- capture content -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                {%- if b.title != blank -%}
                  {%- liquid
                    case b.size
                      when 'display'
                        assign heading_class = 'text-display leading-[1.05]'
                      when 'h1'
                        assign heading_class = 'text-h1'
                      when 'h3'
                        assign heading_class = 'text-h3'
                      when 'h4'
                        assign heading_class = 'text-h4'
                      else
                        assign heading_class = 'text-h2'
                    endcase
                    if b.tag != 'auto'
                      assign tag = b.tag
                    elsif b.size == 'h3' or b.size == 'h4'
                      assign tag = b.size
                    else
                      assign tag = 'h2'
                    endif
                  -%}
                  <{{ tag }} class="{{ heading_class }} whitespace-pre-line">{{ b.title | escape }}</{{ tag }}>
                {%- endif -%}

              {%- when 'eyebrow' -%}
                {%- if b.eyebrow != blank -%}
                  <p class="text-tertiary uppercase tracking-[0.08em] opacity-80">{{ b.eyebrow | escape }}</p>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if b.body != blank -%}
                  <div class="sb-prose{% if b.size == 'small' %} sb-bk-small{% elsif b.size == 'lead' %} sb-bk-lead{% endif %}{% if b.narrow %} sb-bk-measure{% endif %}">{{ b.body }}</div>
                {%- endif -%}

              {%- when 'image' -%}
                {%- if b.image != blank or request.design_mode -%}
                  <figure class="sb-bk-row">
                    <div class="sb-bk-media" data-size="{{ b.size }}">
                      {%- if b.href != blank -%}<a href="{{ b.href }}" class="block">{%- endif -%}
                      {%- render 'sb-picture', image: b.image, ratio: b.ratio, sizes: '(max-width: 749px) 100vw, 50vw' -%}
                      {%- if b.href != blank -%}</a>{%- endif -%}
                      {%- if b.caption != blank -%}
                        <figcaption class="text-tertiary text-muted mt-3">{{ b.caption | escape }}</figcaption>
                      {%- endif -%}
                    </div>
                  </figure>
                {%- endif -%}

              {%- when 'button' -%}
                {%- liquid
                  # Liquid has no operator precedence, so each button is decided on its own line.
                  assign first = false
                  assign second = false
                  if b.link_label != blank and b.link_url != blank
                    assign first = true
                  endif
                  if b.second_label != blank and b.second_url != blank
                    assign second = true
                  endif
                -%}
                {%- if first or second -%}
                  <div data-sb-buttons class="sb-bk-row"{% if b.stretch %} data-stretch{% endif %}>
                    {%- if first -%}
                      {%- if b.link_url contains '://' -%}{%- assign external = true -%}{%- else -%}{%- assign external = false -%}{%- endif -%}
                      {%- render 'sb-button', label: b.link_label, href: b.link_url, variant: b.style, external: external -%}
                    {%- endif -%}
                    {%- if second -%}
                      {%- if b.second_url contains '://' -%}{%- assign external = true -%}{%- else -%}{%- assign external = false -%}{%- endif -%}
                      {%- render 'sb-button', label: b.second_label, href: b.second_url, variant: b.second_style, external: external -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'icon' -%}
                {%- capture words -%}
                  {%- if b.title != blank -%}<h3 class="text-h3">{{ b.title | escape }}</h3>{%- endif -%}
                  {%- if b.body != blank -%}<div class="sb-prose{% if b.title != blank %} mt-2{% endif %}" style="font-size: var(--fs-secondary);">{{ b.body }}</div>{%- endif -%}
                  {%- if b.link_label != blank and b.link_url != blank -%}
                    <a href="{{ b.link_url }}" class="sb-underline text-button mt-4 inline-block uppercase">{{ b.link_label | escape }}</a>
                  {%- endif -%}
                {%- endcapture -%}
                {%- capture icon -%}
                  {%- if b.icon != 'none' -%}
                    <span class="sb-bk-icon inline-flex" data-size="{{ b.icon_size }}">{%- render 'sb-section-icon', icon: b.icon, class: 'size-full' -%}</span>
                  {%- endif -%}
                {%- endcapture -%}
                {%- if icon != blank or words != blank -%}
                  {%- if b.layout == 'beside' -%}
                    <div class="sb-bk-beside">{{ icon }}<div class="min-w-0">{{ words }}</div></div>
                  {%- else -%}
                    {%- if icon != blank -%}<div class="sb-bk-row mb-4">{{ icon }}</div>{%- endif -%}
                    <div class="min-w-0">{{ words }}</div>
                  {%- endif -%}
                {%- endif -%}

              {%- when 'card' -%}
                {%- if b.image != blank or request.design_mode or b.title != blank or b.body != blank or b.link_label != blank -%}
                  <div class="sb-bk-card" data-style="{{ b.style }}">
                    {%- render 'sb-picture', image: b.image, ratio: b.ratio, sizes: '(max-width: 749px) 100vw, 33vw', class: 'mb-5' -%}
                    {%- if b.title != blank -%}<h3 class="text-h3">{{ b.title | escape }}</h3>{%- endif -%}
                    {%- if b.body != blank -%}<div class="sb-prose{% if b.title != blank %} mt-2{% endif %}" style="font-size: var(--fs-secondary);">{{ b.body }}</div>{%- endif -%}
                    {%- if b.link_label != blank and b.link_url != blank -%}
                      <a href="{{ b.link_url }}" class="sb-underline text-button mt-4 inline-block uppercase">{{ b.link_label | escape }}</a>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'video' -%}
                {%- if b.url != blank or request.design_mode -%}
                  {%- liquid
                    case b.ratio
                      when '4:3'
                        assign ratio_class = 'aspect-[4/3]'
                      when '9:16'
                        assign ratio_class = 'aspect-[9/16] max-h-[85svh]'
                      else
                        assign ratio_class = 'aspect-video'
                    endcase
                    assign name = b.caption | default: 'Video'
                    assign play_label = 'sections.video.play' | t: name: name
                  -%}
                  <figure{% if b.ratio == '9:16' %} class="max-w-[28rem]"{% endif %}>
                    <div
                      class="bg-off-black relative w-full overflow-hidden {{ ratio_class }}"
                      data-sb-video
                      data-provider="{{ b.url.type }}"
                      data-id="{{ b.url.id }}"
                      data-title="{{ name | escape }}"
                    >
                      <button
                        type="button"
                        data-sb-video-play
                        aria-label="{{ play_label | escape }}"
                        {%- if b.url == blank %} disabled{% endif %}
                        class="group absolute inset-0 flex items-center justify-center"
                      >
                        {%- if b.cover != blank -%}
                          {%- render 'sb-image',
                            image: b.cover,
                            alt: '',
                            sizes: '(max-width: 749px) 100vw, 80vw',
                            widths: '620, 830, 1240, 1660, 2200',
                            class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]'
                          -%}
                        {%- endif -%}
                        <span data-surface="light" class="bg-background text-foreground relative flex size-16 items-center justify-center rounded-full transition-transform group-hover:scale-105 sm:size-20">
                          <svg class="ml-1 size-6 sm:size-7" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
                        </span>
                      </button>
                    </div>
                    {%- if b.caption != blank -%}
                      <figcaption class="text-tertiary text-muted mt-3">{{ b.caption | escape }}</figcaption>
                    {%- endif -%}
                  </figure>
                {%- endif -%}

              {%- when 'list' -%}
                {%- assign items = b.items | newline_to_br | split: '<br />' -%}
                {%- capture list_items -%}
                  {%- for item in items -%}
                    {%- assign line = item | strip -%}
                    {%- if line != blank -%}<li>{{ line | escape }}</li>{%- endif -%}
                  {%- endfor -%}
                {%- endcapture -%}
                {%- if list_items != blank -%}
                  {%- if b.marker == 'number' -%}{%- assign list_tag = 'ol' -%}{%- else -%}{%- assign list_tag = 'ul' -%}{%- endif -%}
                  <{{ list_tag }} class="sb-bk-list text-body" data-marker="{{ b.marker }}">{{ list_items }}</{{ list_tag }}>
                {%- endif -%}

              {%- when 'quote' -%}
                {%- if b.quote != blank -%}
                  <figure>
                    <blockquote class="whitespace-pre-line {% if b.size == 'large' %}text-h3{% else %}text-body{% endif %}">“{{ b.quote | strip | escape }}”</blockquote>
                    {%- if b.author != blank or b.role != blank -%}
                      <figcaption class="text-tertiary mt-4 uppercase tracking-[0.08em]">
                        {{- b.author | escape -}}
                        {%- if b.author != blank and b.role != blank -%}<span class="text-muted"> — </span>{%- endif -%}
                        {%- if b.role != blank -%}<span class="text-muted">{{ b.role | escape }}</span>{%- endif -%}
                      </figcaption>
                    {%- endif -%}
                  </figure>
                {%- endif -%}

              {%- when 'fold' -%}
                {%- if b.title != blank -%}
                  <details class="sb-bk-fold"{% if b.open %} open{% endif %}>
                    <summary><h3 class="text-h4">{{ b.title | escape }}</h3></summary>
                    {%- if b.body != blank -%}<div class="sb-prose">{{ b.body }}</div>{%- endif -%}
                  </details>
                {%- endif -%}

              {%- when 'line' -%}
                {%- liquid
                  assign line_color = b.color | default: 'var(--sb-border)'
                  case b.length
                    when 'half'
                      assign line_width = '50%'
                    when 'short'
                      assign line_width = '4rem'
                    else
                      assign line_width = '100%'
                  endcase
                -%}
                <div class="sb-bk-row"><hr class="m-0 border-0" style="border-top:{{ b.thickness }}px solid {{ line_color }};width:{{ line_width }};"></div>

              {%- when 'space' -%}
                <div aria-hidden="true" class="sb-bk-space" style="--bk-h:{{ b.height }}px;--bk-hm:{{ b.height_mobile }}px;"></div>

              {%- when 'product' -%}
                {%- if b.product != blank -%}
                  {%- render 'sb-product-card', product: b.product -%}
                {%- endif -%}
            {%- endcase -%}
          {%- endcapture -%}

          {%- if content != blank -%}
            <div
              class="sb-bk"
              data-type="{{ block.type }}"
              {%- if b.align != blank and b.align != 'inherit' %} data-align="{{ b.align }}"{% endif %}
              {%- if b.space != blank and b.space != 'auto' %} data-space="{{ b.space }}"{% endif %}
              {%- if b.hide_on == 'mobile' or b.hide_on == 'desktop' %} data-hide="{{ b.hide_on }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              {{- content -}}
            </div>
          {%- endif -%}
          {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom section",
  "tag": "section",
  "class": "sb-section-custom-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "info": "Every block lines up this way, unless it has its own."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "full",
          "label": "Edge to edge"
        }
      ],
      "default": "page",
      "info": "Narrow is easiest to read. Edge to edge has no side margins — for photos."
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Space between blocks",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        },
        {
          "value": "xl",
          "label": "XL"
        }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "column_gap",
      "label": "Space between columns",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        },
        {
          "value": "xl",
          "label": "XL"
        }
      ],
      "default": "md",
      "info": "Only when the section has Column blocks."
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Show on",
      "options": [
        {
          "value": "none",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Desktop only"
        },
        {
          "value": "desktop",
          "label": "Mobile only"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        {
          "value": "inherit",
          "label": "Same as page"
        },
        {
          "value": "light",
          "label": "Earth"
        },
        {
          "value": "dark",
          "label": "Dark wood"
        },
        {
          "value": "olive",
          "label": "Black olive"
        },
        {
          "value": "blue",
          "label": "Charcoal blue"
        },
        {
          "value": "mocha",
          "label": "Deep mocha"
        },
        {
          "value": "black",
          "label": "Off-black"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "rhythm",
      "label": "Vertical spacing",
      "options": [
        {
          "value": "theme",
          "label": "Standard"
        },
        {
          "value": "xs",
          "label": "Extra small"
        },
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra large"
        }
      ],
      "default": "theme"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "info": "Your own colour instead of the Background choice above. Leave empty to keep that choice."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "info": "Headings, text and buttons in this section."
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Custom spacing",
      "default": false,
      "info": "Set the space inside and around this section yourself, in pixels. Replaces Vertical spacing."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space inside, top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space inside, bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Space above the section",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Space below the section",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "border",
      "label": "Line",
      "options": [
        {
          "value": "none",
          "label": "No line"
        },
        {
          "value": "all",
          "label": "Box around"
        },
        {
          "value": "top",
          "label": "Line above"
        },
        {
          "value": "bottom",
          "label": "Line below"
        },
        {
          "value": "y",
          "label": "Lines above and below"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Line thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Line colour",
      "info": "Leave empty for a soft line in the text colour."
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Rounded corners",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "paragraph",
      "content": "Design — empty uses the design’s own value. “On phones” is for screens narrower than 750px."
    },
    {
      "type": "header",
      "content": "Headings"
    },
    {
      "type": "select",
      "id": "d_h_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "Default (Helvetica Neue)"
        },
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "dm-sans",
          "label": "DM Sans"
        },
        {
          "value": "manrope",
          "label": "Manrope"
        },
        {
          "value": "work-sans",
          "label": "Work Sans"
        },
        {
          "value": "space-grotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "syne",
          "label": "Syne"
        },
        {
          "value": "playfair-display",
          "label": "Playfair Display"
        },
        {
          "value": "cormorant-garamond",
          "label": "Cormorant Garamond"
        },
        {
          "value": "fraunces",
          "label": "Fraunces"
        },
        {
          "value": "eb-garamond",
          "label": "EB Garamond"
        }
      ],
      "default": "default"
    },
    {
      "type": "number",
      "id": "d_h_size",
      "label": "Size (px)",
      "placeholder": "Default"
    },
    {
      "type": "number",
      "id": "d_h_size_m",
      "label": "Size on phones (px)",
      "placeholder": "Same as desktop"
    },
    {
      "type": "select",
      "id": "d_h_weight",
      "label": "Weight",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "default"
