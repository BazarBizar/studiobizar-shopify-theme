{% comment %}
  Website → Templates → Product page → "The idea" (product_idea). The story behind the
  product with its photo; left out on a product that has none, as on the route.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign m = product.metafields.custom
  assign body = m.idea_body.value
  assign image = m.idea_image.value

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  assign heading = s.title
  if heading == blank
    assign heading = 'product.the_idea' | t
  endif
  case s.ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'adapt'
      assign ratio = image.aspect_ratio | default: '2 / 3'
    else
      assign ratio = '2 / 3'
  endcase
  assign block_surface = 'inherit'
  if s.tone == 'olive'
    assign block_surface = 'olive'
  endif
-%}

{%- if body != blank -%}
  <div
    {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
    {% render 'sb-section-style', settings: s %}
    {{ section.shopify_attributes }}
  >
    {%- render 'sb-media-text-block',
      heading: heading,
      body: body,
      image: image,
      align: s.align,
      ratio: ratio,
      padding: s.padding,
      surface: block_surface,
      image_width: s.image_width,
      vertical_align: s.vertical_align
    -%}
  </div>
{%- endif -%}

