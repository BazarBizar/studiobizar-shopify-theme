{% comment %}
  Website → Templates → Collection page → "Collection pieces" (collection_products).
  The collection's name and description, then its products: the design's mosaic of
  large and small (CollectionHighlightGrid — rows of 1·1·1·1, 1·1·2, 2·1·1, up to ten)
  or an even grid.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  capture title_class
    render 'sb-template-heading', size: s.heading_size, align: s.heading_align, fallback: 'text-h1'
  endcapture
  capture look
    render 'sb-template-look', columns_desktop: s.columns_desktop, columns_mobile: s.columns_mobile, gap: s.gap, image_shape: s.image_shape, image_radius: s.image_radius, image_overlay: s.image_overlay, overlay_color: s.overlay_color, overlay_opacity: s.overlay_opacity, card_style: s.card_style, card_color: s.card_color, card_border_color: s.card_border_color, title_size: s.title_size, title_color: s.title_color, card_align: s.card_align
  endcapture

  comment
    The mosaic takes at most ten, and only whole rows: 4, then 3, then 3.
  endcomment
  assign limit = s.limit
  if s.layout != 'grid'
    if limit > 10
      assign limit = 10
    endif
    assign in_collection = collection.products_count
    if in_collection < limit
      assign limit = in_collection
    endif
    if limit >= 10
      assign limit = 10
    elsif limit >= 7
      assign limit = 7
    elsif limit >= 4
      assign limit = 4
    else
      assign limit = 0
    endif
  endif
-%}

{%- if collection != blank -%}
  <div
    {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
    {% render 'sb-section-style', settings: s %}
    {{ section.shopify_attributes }}
  >
    <div class="sb-container pb-section">
      {%- if s.show_title -%}
        <h2 class="{{ title_class }}"{% if s.heading_color != blank %} style="color: {{ s.heading_color }}"{% endif %}>{{ collection.title }}</h2>
      {%- endif -%}
      {%- if s.show_description and collection.description != blank -%}
        <div class="sb-prose mt-6 max-w-[46rem]">{{ collection.description }}</div>
      {%- endif -%}

      <div class="{% if s.show_title or s.show_description %}mt-12{% endif %}">
        {%- if look != blank -%}<div {{ look }}>{%- endif -%}
        {%- if s.layout == 'grid' -%}
          <ul class="sb-grid-4">
            {%- for item in collection.products limit: limit -%}
              <li>{%- render 'sb-product-card', product: item, priority: forloop.first -%}</li>
            {%- endfor -%}
          </ul>
        {%- elsif limit > 0 -%}
          <div class="flex flex-col gap-grid-gap">
            {%- for item in collection.products limit: limit -%}
              {%- liquid
                assign i = forloop.index0
                comment
                  Row 1: four singles (0–3). Row 2: single, single, double (4–6).
                  Row 3: double, single, single (7–9).
                endcomment
                assign wide = false
                if i == 6 or i == 7
                  assign wide = true
                endif
                assign opens_row = false
                if i == 0 or i == 4 or i == 7
                  assign opens_row = true
                endif
                assign closes_row = false
                if i == 3 or i == 6 or i == 9
                  assign closes_row = true
                endif
                assign first_row = false
                if i < 4
                  assign first_row = true
                endif
              -%}
              {%- if opens_row -%}<ul class="grid grid-cols-4 gap-grid-gap">{%- endif -%}
              {%- if wide -%}
                <li class="col-span-4 sm:col-span-2">{%- render 'sb-product-card', product: item, aspect: 'wide', priority: first_row -%}</li>
              {%- else -%}
                <li class="col-span-2 sm:col-span-1">{%- render 'sb-product-card', product: item, priority: first_row -%}</li>
              {%- endif -%}
              {%- if closes_row -%}</ul>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if look != blank -%}</div>{%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

