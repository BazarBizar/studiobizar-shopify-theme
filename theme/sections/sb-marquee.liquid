{% comment %}
  Scrolling text — the page builder's `marquee`
  (components/sections/landing/marquee.tsx). Pure CSS (`sb-marquee` in
  theme-build/sb-theme.css): the strip is drawn twice and moved by half its
  width, so the loop has no seam; the global reduced-motion rule stops it.

  The moving copy is hidden from assistive technology; the phrases are read once
  from a visually hidden list.

  The schema below is GENERATED from lib/page-builder/sections-landing.ts by
  `yarn liquid:schemas`; change the section there, not here.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  capture size_class
    render 'sb-heading-class', size: s.size
  endcapture

  case s.speed
    when 'slow'
      assign duration = '70s'
    when 'fast'
      assign duration = '25s'
    else
      assign duration = '45s'
  endcase

  case s.separator
    when 'dash'
      assign mark = '—'
    when 'star'
      assign mark = '✦'
    when 'none'
      assign mark = ''
    else
      assign mark = '·'
  endcase

  assign count = 0
  for block in section.blocks
    if block.settings.text != blank
      assign count = count | plus: 1
    endif
  endfor

  comment
    Repeated so one copy is always wider than the screen, whatever the number of
    phrases — the same arithmetic as Math.max(2, ceil(8 / phrases)).
  endcomment
  assign rounds = 2
  if count > 0
    assign rounds = 8 | plus: count | minus: 1 | divided_by: count
    if rounds < 2
      assign rounds = 2
    endif
  endif
-%}

<div
  {% if s.surface != 'inherit' %}data-surface="{{ s.surface }}"{% endif %}
  class="{% if s.surface != 'inherit' %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  {{ section.shopify_attributes }}
>
  {%- if count > 0 -%}
    <div class="py-section-xs overflow-hidden{% if s.lines %} border-border border-y{% endif %}">
      <ul class="sr-only">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}<li>{{ block.settings.text }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
      <div
        class="sb-marquee flex w-max {{ size_class }}{% if s.direction == 'right' %} [animation-direction:reverse]{% endif %}"
        style="--sb-marquee-duration: {{ duration }};"
      >
        {%- for copy in (1..2) -%}
          <ul aria-hidden="true" class="flex shrink-0 items-center">
            {%- for round in (1..rounds) -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
                <li class="flex items-center whitespace-nowrap" {% if copy == 1 and round == 1 %}{{ block.shopify_attributes }}{% endif %}>
                  <span class="px-6 sm:px-10">{{ block.settings.text }}</span>
                  {%- if mark != '' -%}<span class="opacity-50">{{ mark }}</span>{%- endif -%}
                </li>
              {%- endfor -%}
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

