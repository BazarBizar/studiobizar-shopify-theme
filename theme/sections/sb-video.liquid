{% comment %}
  Video — the page builder's `video` (components/sections/landing/video-embed.tsx).
  A YouTube or Vimeo film behind a cover. Nothing is requested from YouTube or
  Vimeo until play is pressed: assets/sb-sections.js (`[data-sb-video]`) builds
  the iframe from the provider and id Shopify parsed out of the address —
  YouTube's privacy-enhanced host, Vimeo with do-not-track.

  The schema below is GENERATED from lib/page-builder/sections-landing.ts by
  `yarn liquid:schemas`; change the section there, not here.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  case s.ratio
    when '4:3'
      assign ratio_class = 'aspect-[4/3]'
    when '21:9'
      assign ratio_class = 'aspect-[21/9]'
    when '9:16'
      assign ratio_class = 'aspect-[9/16] max-h-[85svh]'
    else
      assign ratio_class = 'aspect-video'
  endcase

  case s.width
    when 'narrow'
      assign width_class = 'max-w-[44rem]'
    when 'medium'
      assign width_class = 'max-w-[64rem]'
    else
      assign width_class = 'max-w-none'
  endcase

  assign name = s.title | default: s.caption | default: 'Video'
  assign play_label = 'sections.video.play' | t: name: name
-%}

<div
  {% if s.surface != 'inherit' %}data-surface="{{ s.surface }}"{% endif %}
  class="{% if s.surface != 'inherit' %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  {{ section.shopify_attributes }}
>
  {%- if s.url != blank or request.design_mode -%}
    <div class="sb-container py-section">
      {%- render 'sb-section-header', heading: s.title, intro: s.intro, align: s.heading_align -%}
      <figure class="mx-auto {{ width_class }}{% if s.ratio == '9:16' %} max-w-[28rem]{% endif %}">
        <div
          class="bg-off-black relative w-full overflow-hidden {{ ratio_class }}"
          data-sb-video
          data-provider="{{ s.url.type }}"
          data-id="{{ s.url.id }}"
          data-title="{{ name | escape }}"
        >
          <button
            type="button"
            data-sb-video-play
            aria-label="{{ play_label | escape }}"
            {%- if s.url == blank %} disabled{% endif %}
            class="group absolute inset-0 flex items-center justify-center"
          >
            {%- if s.cover != blank -%}
              {%- render 'sb-image',
                image: s.cover,
                alt: '',
                sizes: '(max-width: 749px) 100vw, 80vw',
                widths: '620, 830, 1240, 1660, 2200',
                class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]'
              -%}
            {%- endif -%}
            <span data-surface="light" class="bg-background text-foreground relative flex size-16 items-center justify-center rounded-full transition-transform group-hover:scale-105 sm:size-20">
              <svg class="ml-1 size-6 sm:size-7" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
            </span>
          </button>
        </div>
        {%- if s.caption != blank -%}
          <figcaption class="text-tertiary text-muted mt-3">{{ s.caption }}</figcaption>
        {%- endif -%}
      </figure>
    </div>
  {%- endif -%}
</div>

{% schema %}
