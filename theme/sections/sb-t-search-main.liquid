{% comment %}
  Website → Templates → Search results → "Search box and results" (search_main). The
  heading, a search box, how many were found and the products, 24 at a time with
  "load more" (assets/sb-collection.js scrolls it, as on a collection).
  `search.results` can hold pages and articles too; only products are shown, as in Next.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  assign heading = s.title
  if heading == blank
    assign heading = 'search.title' | t
  endif
  assign placeholder = s.placeholder | default: 'Search products'
  assign button_label = s.button | default: 'Search'
  comment
    The visitor's own words go into the page: escaped first, everywhere.
  endcomment
  assign safe_terms = search.terms | escape
  assign empty_text = s.empty | default: 'Nothing matched “{query}”. Try a different word, or browse' | escape
  assign empty_text = empty_text | replace: '{query}', safe_terms
  assign search_label = 'search.label' | t
  assign all_products = 'search.all_products' | t
  assign load_more_label = 'collection.load_more' | t

  capture title_class
    render 'sb-template-heading', size: s.heading_size, align: s.heading_align, fallback: 'text-h1'
  endcapture
  capture look
    render 'sb-template-look', image_shape: s.image_shape, image_radius: s.image_radius, image_overlay: s.image_overlay, overlay_color: s.overlay_color, overlay_opacity: s.overlay_opacity, card_style: s.card_style, card_color: s.card_color, card_border_color: s.card_border_color, title_size: s.title_size, title_color: s.title_color, card_align: s.card_align
  endcapture
-%}

<div
  {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  data-sb-collection
  data-section-id="{{ section.id }}"
  {% render 'sb-section-style', settings: s %}
  {{ section.shopify_attributes }}
>
  <div class="sb-container py-section">
    <h1 class="{{ title_class }}"{% if s.heading_color != blank %} style="color: {{ s.heading_color }}"{% endif %}>{{ heading }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="mt-8 max-w-[32rem]">
      <input type="hidden" name="type" value="product">
      <div class="flex items-center gap-4 border-b border-foreground pb-2">
        <label for="q-{{ section.id }}" class="sr-only">{{ search_label }}</label>
        <input
          id="q-{{ section.id }}"
          name="q"
          type="search"
          value="{{ search.terms | escape }}"
          placeholder="{{ placeholder | escape }}"
          class="text-body w-full bg-transparent placeholder:text-muted focus:outline-none"
        >
        <button type="submit" class="text-button shrink-0 uppercase tracking-[0.06em]">{{ button_label }}</button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if s.show_count -%}
          {%- if search.results_count == 1 -%}
            {%- assign found = 'search.results.one' | t: count: search.results_count, terms: safe_terms -%}
          {%- else -%}
            {%- assign found = 'search.results.other' | t: count: search.results_count, terms: safe_terms -%}
          {%- endif -%}
          <p class="text-tertiary mt-6 text-muted">{{ found }}</p>
        {%- endif -%}

        {%- capture cards -%}
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <li>{%- render 'sb-product-card', product: item -%}</li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if cards contains '<li>' -%}
          <div class="mt-10">
            {%- if look != blank -%}<div {{ look }}>{%- endif -%}
            <ul class="sb-grid-4" data-sb-collection-grid>{{ cards }}</ul>
            {%- if look != blank -%}</div>{%- endif -%}
            {%- if paginate.next -%}
              <div class="mt-12 flex justify-center" data-sb-collection-more>
                {%- render 'sb-button', label: load_more_label, href: paginate.next.url, variant: 'outline' -%}
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <p class="text-body mt-10 text-muted">
            {{ empty_text }} <a href="{{ routes.all_products_collection_url }}" class="sb-underline">{{ all_products }}</a>.
          </p>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

