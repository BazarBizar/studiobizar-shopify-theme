{% comment %}
  Website → Templates → Designer page → "Their collections" (designer_collections). The
  collections that credit the designer (an identity check on the metaobject, as in
  sb-t-designer-profile), as cards. Left out when there are none.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign designer = metaobject

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  assign heading = s.title | default: 'Collections'
  if heading == blank
    assign heading = 'Collections'
  endif
  capture title_class
    render 'sb-template-heading', size: s.heading_size, align: s.heading_align, fallback: 'text-h2'
  endcapture
  capture look
    render 'sb-template-look', columns_desktop: s.columns_desktop, columns_mobile: s.columns_mobile, gap: s.gap, image_shape: s.image_shape, image_radius: s.image_radius, image_overlay: s.image_overlay, overlay_color: s.overlay_color, overlay_opacity: s.overlay_opacity, card_style: s.card_style, card_color: s.card_color, card_border_color: s.card_border_color, title_size: s.title_size, title_color: s.title_color, card_align: s.card_align, mark_size: s.mark_size, mark_color: s.mark_color, byline_size: s.byline_size, byline_color: s.byline_color
  endcapture
-%}

{%- capture cards -%}
  {%- for item in collections -%}
    {%- assign credit = item.metafields.custom.designer.value -%}
    {%- if credit != blank and credit.system.id == designer.system.id -%}
      <li>{%- render 'sb-collection-card', collection: item -%}</li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if cards contains '<li>' -%}
  <div
    {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
    {% render 'sb-section-style', settings: s %}
    {{ section.shopify_attributes }}
  >
    <div class="sb-container pb-section">
      <h2 class="{{ title_class }} mb-8"{% if s.heading_color != blank %} style="color: {{ s.heading_color }}"{% endif %}>{{ heading }}</h2>
      {%- if look != blank -%}<div {{ look }}>{%- endif -%}
      <ul class="sb-grid-4 [&_article_h2]:text-foreground [&_[data-byline]]:text-muted">{{ cards }}</ul>
      {%- if look != blank -%}</div>{%- endif -%}
    </div>
  </div>
{%- endif -%}

