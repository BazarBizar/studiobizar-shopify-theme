{% comment %}
  Website → Templates → All products → "Products with filters" (shop_main).

  In Shopify, Shop All is the automatic `all` collection, so this reads `collection`
  like sb-main-collection: Shopify's own filters (Search & Discovery), its sort options
  without the price ones, `paginate` turned into infinite scroll by
  assets/sb-collection.js, and the visitor's S / M / L size from `?size=`.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  assign heading = s.title
  if heading == blank
    assign heading = 'shop.title' | t
  endif
  capture title_class
    render 'sb-template-heading', size: s.heading_size, align: s.heading_align, fallback: 'text-h1'
  endcapture
  capture look
    render 'sb-template-look', image_shape: s.image_shape, image_radius: s.image_radius, image_overlay: s.image_overlay, overlay_color: s.overlay_color, overlay_opacity: s.overlay_opacity, card_style: s.card_style, card_color: s.card_color, card_border_color: s.card_border_color, title_size: s.title_size, title_color: s.title_color, card_align: s.card_align
  endcapture

  assign load_more_label = 'collection.load_more' | t
  assign size = 'l'
  assign size_base = ''
  assign pairs = request.query_string | split: '&'
  for pair in pairs
    assign parts = pair | split: '='
    case parts[0]
      when 'size'
        if parts[1] == 's' or parts[1] == 'm' or parts[1] == 'l'
          assign size = parts[1]
        endif
      when 'page', 'section_id'
        continue
      else
        assign size_base = size_base | append: pair | append: '&'
    endcase
  endfor
  case size
    when 's'
      assign grid_class = 'grid grid-cols-4 gap-grid-gap min-[750px]:grid-cols-8'
      assign card_sizes = '(max-width: 749px) 25vw, 12.5vw'
    when 'm'
      assign grid_class = 'grid grid-cols-3 gap-grid-gap min-[750px]:grid-cols-6'
      assign card_sizes = '(max-width: 749px) 34vw, 17vw'
    else
      assign grid_class = 'sb-grid-4'
      assign card_sizes = nil
  endcase
  assign compact = false
  if size == 's'
    assign compact = true
  endif
-%}

<div
  {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  data-sb-collection
  data-section-id="{{ section.id }}"
  {% render 'sb-section-style', settings: s %}
  {{ section.shopify_attributes }}
>
  <div class="sb-container pt-12 pb-section">
    <header class="max-w-[46rem]">
      <h1 class="{{ title_class }}"{% if s.heading_color != blank %} style="color: {{ s.heading_color }}"{% endif %}>{{ heading }}</h1>
      {%- if s.intro != blank -%}
        <p class="text-body mt-6 whitespace-pre-line">{{ s.intro | escape }}</p>
      {%- endif -%}
      {%- if current_tags.size > 0 -%}
        <p class="text-secondary mt-6">
          {{ 'collection.showing' | t }}
          <span class="font-medium">{{ current_tags | join: ' · ' | escape }}</span>
          ·
          <a href="{{ collection.url }}" class="sb-underline">{{ 'collection.show_everything' | t }}</a>
        </p>
      {%- endif -%}
    </header>

    {%- if collection != blank -%}
      {%- paginate collection.products by 24 -%}
        {%- if s.show_controls -%}
          <div class="mt-12 flex flex-col gap-6">
            {%- if collection.filters.size > 0 -%}
              <form method="get" data-sb-collection-filters>
                {%- for filter in collection.filters -%}
                  {%- if filter.type == 'list' -%}
                    <ul class="flex flex-wrap items-center gap-x-8 gap-y-3">
                      <li>
                        <a href="{{ collection.url }}?size={{ size }}" class="text-secondary sb-underline{% unless current_tags or filter.active_values.size > 0 %} font-medium{% endunless %}">{{ 'collection.all' | t }}</a>
                      </li>
                      {%- for value in filter.values -%}
                        {%- if value.count > 0 -%}
                          <li>
                            <a
                              href="{{ value.url_to_add }}{% if value.url_to_add contains '?' %}&{% else %}?{% endif %}size={{ size }}"
                              {% if value.active %}aria-current="true"{% endif %}
                              class="text-secondary sb-underline{% if value.active %} font-medium{% endif %}"
                            >{{ value.label | downcase }}</a>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                {%- endfor -%}
              </form>
            {%- endif -%}
            <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border pt-4">
              <div class="flex items-center gap-3">
                {%- render 'sb-collection-sort', size: size -%}
                <span class="text-tertiary text-muted">{{ 'collection.item_count' | t: count: collection.products_count }}</span>
              </div>
              <div class="flex items-center gap-4">
                <span class="text-secondary">{{ 'collection.size' | t }}:</span>
                {%- assign size_options = 's,m,l' | split: ',' -%}
                {%- for option in size_options -%}
                  {%- assign option_label_key = 'collection.size_' | append: option | append: '_label' -%}
                  <a
                    href="{{ request.path }}?{{ size_base }}size={{ option }}"
                    {% if size == option %}aria-current="true"{% endif %}
                    aria-label="{{ option_label_key | t }}"
                    class="text-secondary sb-underline uppercase{% if size == option %} font-medium{% else %} opacity-60{% endif %}"
                  >{{- option -}}</a>
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}

        <div class="mt-10">
          {%- if collection.products.size == 0 -%}
            <p class="text-body text-muted">{{ 'collection.empty' | t }}</p>
          {%- else -%}
            {%- if look != blank -%}<div {{ look }}>{%- endif -%}
            <ul class="{{ grid_class }}" data-sb-collection-grid>
              {%- for item in collection.products -%}
                <li>{%- render 'sb-product-card', product: item, priority: forloop.first, sizes: card_sizes, compact: compact -%}</li>
              {%- endfor -%}
            </ul>
            {%- if look != blank -%}</div>{%- endif -%}
            {%- if paginate.next -%}
              <div class="mt-12 flex justify-center" data-sb-collection-more>
                {%- render 'sb-button', label: load_more_label, href: paginate.next.url, variant: 'outline' -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

