{% comment %}
  Columns — the page builder's `multicolumn`
  (components/sections/landing/multicolumn.tsx). Two to five columns, each an
  image or an icon, a heading, text and a link. On phones they stack, pair up,
  or become a native scroll-snap row (`scroll`) — no script.

  The schema below is GENERATED from lib/page-builder/sections-landing.ts by
  `yarn liquid:schemas`; change the section there, not here.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  case s.columns_desktop
    when '2'
      assign desktop_class = 'sm:grid-cols-2'
    when '4'
      assign desktop_class = 'sm:grid-cols-2 lg:grid-cols-4'
    when '5'
      assign desktop_class = 'sm:grid-cols-3 lg:grid-cols-5'
    else
      assign desktop_class = 'sm:grid-cols-2 lg:grid-cols-3'
  endcase

  case s.columns_mobile
    when '2'
      assign mobile_class = 'grid-cols-2'
    when 'scroll'
      assign mobile_class = 'grid-cols-1 max-sm:-mx-[var(--sb-gutter)] max-sm:flex max-sm:snap-x max-sm:snap-mandatory max-sm:gap-[var(--sb-grid-gap)] max-sm:overflow-x-auto max-sm:px-[var(--sb-gutter)]'
    else
      assign mobile_class = 'grid-cols-1'
  endcase

  case s.style
    when 'cards'
      assign list_style = 'gap-y-[var(--sb-grid-gap)]'
    when 'lines'
      assign list_style = 'sm:gap-x-0'
    else
      assign list_style = ''
  endcase

  if s.align == 'center'
    assign item_align = 'items-center text-center'
  else
    assign item_align = 'items-start text-left'
  endif
-%}

<div
  {% if s.surface != 'inherit' %}data-surface="{{ s.surface }}"{% endif %}
  class="{% if s.surface != 'inherit' %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  {% render 'sb-section-style', settings: s %}
  {{ section.shopify_attributes }}
>
  {%- if section.blocks.size > 0 -%}
    <div class="sb-container py-section">
      {%- render 'sb-section-header', heading: s.title, intro: s.intro, align: s.heading_align -%}
      <ul class="grid gap-x-[var(--sb-grid-gap)] gap-y-12 {{ mobile_class }} {{ desktop_class }} {{ list_style }}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li
            class="flex flex-col {{ item_align }}{% if s.columns_mobile == 'scroll' %} max-sm:w-[78%] max-sm:shrink-0 max-sm:snap-start{% endif %}{% if s.style == 'cards' %} bg-foreground/[0.04] p-6 sm:p-8{% endif %}{% if s.style == 'lines' %} sm:px-8 sm:first:pl-0{% unless forloop.first %} border-border sm:border-l{% endunless %}{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- comment -%} A column's own image always shows; Media fills the columns without one. {%- endcomment -%}
            {%- if b.image != blank or s.media == 'image' -%}
              {%- render 'sb-picture', image: b.image, ratio: s.ratio, sizes: '(max-width: 749px) 80vw, 30vw', class: 'mb-6' -%}
            {%- elsif s.media == 'icon' and b.icon != 'none' -%}
              {%- render 'sb-section-icon', icon: b.icon, class: 'mb-5 size-9' -%}
            {%- endif -%}
            {%- if b.title != blank -%}
              <h3 class="text-h3">{{ b.title }}</h3>
            {%- endif -%}
            {%- if b.body != blank -%}
              <div class="sb-prose mt-3" style="font-size: var(--fs-secondary);">{{ b.body }}</div>
            {%- endif -%}
            {%- if b.link_label != blank and b.link_url != blank -%}
              <a href="{{ b.link_url }}" class="sb-underline text-button mt-5 uppercase">{{ b.link_label }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if s.button_label != blank and s.button_url != blank -%}
        <div data-sb-buttons class="mt-12 flex{% if s.heading_align == 'center' %} justify-center{% endif %}">
          {%- render 'sb-button', label: s.button_label, href: s.button_url, variant: 'outline' -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

