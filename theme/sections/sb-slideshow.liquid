{% comment %}
  Slideshow — the page builder's `slideshow`
  (components/sections/landing/slideshow.tsx). Full-width slides, each with its
  own photograph, copy, text position and text colour.

  Slides cross-fade rather than slide. Behaviour lives in assets/sb-sections.js
  (`[data-sb-slideshow]`): autoplay with a pause control, paused on hover and
  focus, never for visitors who prefer reduced motion. Without JavaScript the
  first slide shows, as a still banner.

  On the live store a slide with no photograph is left out, as in Next; in the
  theme editor it stays, with Shopify's placeholder, so it can be filled in.

  The schema below is GENERATED from lib/page-builder/sections-landing.ts by
  `yarn liquid:schemas`; change the section there, not here.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  case s.height
    when 'small'
      assign height_class = 'min-h-[24rem] sm:min-h-[45svh]'
    when 'medium'
      assign height_class = 'min-h-[30rem] sm:min-h-[65svh]'
    when 'screen'
      assign height_class = 'min-h-svh'
    else
      assign height_class = 'min-h-[36rem] sm:min-h-[85svh]'
  endcase

  comment
    Which slides are drawn. `where` cannot reach into block.settings, so they are
    counted by hand; the first one's text colour also colours the controls.
  endcomment
  assign count = 0
  assign first_tone = 'light'
  for block in section.blocks
    if block.settings.image != blank or request.design_mode
      if count == 0
        assign first_tone = block.settings.tone
      endif
      assign count = count | plus: 1
    endif
  endfor

  assign show_arrows = true
  if s.controls == 'dots'
    assign show_arrows = false
  endif
  assign show_dots = true
  if s.controls == 'arrows'
    assign show_dots = false
  endif

  assign label_previous = 'sections.slideshow.previous' | t
  assign label_next = 'sections.slideshow.next' | t
  assign label_pause = 'sections.slideshow.pause' | t
  assign label_play = 'sections.slideshow.play' | t
  assign label_region = 'sections.slideshow.label' | t
-%}

{%- if count > 0 -%}
  <div
    class="bg-off-black relative isolate overflow-hidden {{ height_class }} {{ hide_class }}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ label_region }}"
    data-sb-slideshow
    data-autoplay="{{ s.autoplay }}"
    data-interval="{{ s.interval }}"
    {{ section.shopify_attributes }}
  >
    {%- assign n = 0 -%}
    {%- for block in section.blocks -%}
      {%- unless block.settings.image != blank or request.design_mode -%}{%- continue -%}{%- endunless -%}
      {%- liquid
        assign b = block.settings
        assign n = n | plus: 1
        capture position_class
          render 'sb-position-classes', position: b.position
        endcapture
        if b.tone == 'dark'
          assign tone_surface = 'light'
        else
          assign tone_surface = 'black'
        endif
        case b.position
          when 'top-center', 'middle-center', 'bottom-center'
            assign copy_align = 'center'
          when 'top-right', 'middle-right', 'bottom-right'
            assign copy_align = 'right'
          else
            assign copy_align = 'left'
        endcase
        assign first_slide = false
        if n == 1 and section.index == 1
          assign first_slide = true
        endif
        assign slide_label = 'sections.slideshow.slide' | t: index: n, total: count
      -%}
      <div
        role="group"
        aria-roledescription="slide"
        aria-label="{{ slide_label }}"
        data-sb-slide
        data-tone="{{ tone_surface }}"
        class="absolute inset-0 flex transition-opacity duration-700 ease-in-out {% if n == 1 %}opacity-100{% else %}pointer-events-none opacity-0{% endif %}"
        {%- if n > 1 %} aria-hidden="true" inert{% endif %}
        {{ block.shopify_attributes }}
      >
        {%- render 'sb-cover-image', image: b.image, priority: first_slide -%}
        {%- if b.image != blank and s.overlay > 0 -%}
          <div aria-hidden="true" class="bg-off-black absolute inset-0" style="opacity: {{ s.overlay | divided_by: 100.0 }};"></div>
        {%- endif -%}
        <div
          data-surface="{{ tone_surface }}"
          class="sb-container py-section text-foreground relative flex w-full flex-col pb-20 {{ position_class }}"
        >
          {%- render 'sb-landing-copy',
            eyebrow: b.eyebrow,
            heading: b.title,
            body: b.body,
            heading_size: s.heading_size,
            primary_label: b.link_label,
            primary_url: b.link_url,
            primary_style: b.button_style,
            align: copy_align
          -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if count > 1 -%}
      <div
        data-sb-slideshow-controls
        data-surface="{% if first_tone == 'dark' %}light{% else %}black{% endif %}"
        class="sb-container text-foreground absolute inset-x-0 bottom-6 z-10 flex items-center justify-between gap-4"
      >
        <div class="flex items-center gap-2">
          {%- if show_dots -%}
            {%- for i in (1..count) -%}
              {%- assign dot_label = 'gallery.go_to' | t: index: i, total: count -%}
              <button
                type="button"
                data-sb-slideshow-dot="{{ i | minus: 1 }}"
                aria-label="{{ dot_label }}"
                {%- if i == 1 %} aria-current="true"{% endif %}
                class="h-[2px] w-8 bg-current transition-opacity {% if i == 1 %}opacity-100{% else %}opacity-40 hover:opacity-70{% endif %}"
              ></button>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="flex items-center gap-1">
          {%- if s.autoplay -%}
            <button
              type="button"
              data-sb-slideshow-toggle
              data-label-pause="{{ label_pause }}"
              data-label-play="{{ label_play }}"
              aria-label="{{ label_pause }}"
              hidden
              class="flex size-9 items-center justify-center opacity-80 hover:opacity-100"
            >
              <svg data-icon="pause" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="14" y="3" width="5" height="18" rx="1"/><rect x="5" y="3" width="5" height="18" rx="1"/></svg>
              <svg data-icon="play" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" hidden><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></svg>
            </button>
          {%- endif -%}
          {%- if show_arrows -%}
            <button type="button" data-sb-slideshow-prev aria-label="{{ label_previous }}" class="flex size-9 items-center justify-center opacity-80 hover:opacity-100">
              {%- render 'sb-icon', icon: 'arrow-left', class: 'size-5', size: 1.25 -%}
            </button>
            <button type="button" data-sb-slideshow-next aria-label="{{ label_next }}" class="flex size-9 items-center justify-center opacity-80 hover:opacity-100">
              {%- render 'sb-icon', icon: 'arrow-right', class: 'size-5', size: 1.25 -%}
            </button>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "sb-section-slideshow",
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "Standard"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "display",
          "label": "Extra large"
        }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "screen",
          "label": "Full screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Image darkening",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 30,
      "info": "Darkens the photograph so the text stays readable. 0 shows it as it is."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Change slides automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "select",
      "id": "controls",
      "label": "Controls",
      "options": [
        {
          "value": "both",
          "label": "Arrows and dots"
        },
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "arrows",
          "label": "Arrows"
        }
      ],
      "default": "both"
    },
    {
      "type": "select",
      "id": "hide_on",
      "label": "Show on",
      "options": [
        {
          "value": "none",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Desktop only"
        },
        {
          "value": "desktop",
          "label": "Mobile only"
        }
      ],
      "default": "none"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "solid",
              "label": "Filled"
            },
            {
              "value": "outline",
              "label": "Outlined"
            },
            {
              "value": "text",
              "label": "Underlined text"
            }
          ],
          "default": "solid"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Text position",
          "options": [
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-center",
              "label": "Top centre"
            },
            {
              "value": "top-right",
              "label": "Top right"
            },
            {
              "value": "middle-left",
              "label": "Middle left"
            },
            {
              "value": "middle-center",
              "label": "Centre"
            },
            {
              "value": "middle-right",
              "label": "Middle right"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-center",
              "label": "Bottom centre"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            }
          ],
          "default": "bottom-left"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Text colour",
          "options": [
            {
              "value": "light",
              "label": "Light text"
            },
            {
              "value": "dark",
              "label": "Dark text"
            }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "New in",
            "title": "Soft geometry",
            "link_label": "discover",
            "link_url": "/shop"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Collections",
            "title": "Rooms with a story",
            "link_label": "see the collections",
            "link_url": "/collections"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Projects",
            "title": "Spaces we furnished",
            "link_label": "see projects",
            "link_url": "/projects"
          }
        }
      ]
    }
  ]
}
{% endschema %}
