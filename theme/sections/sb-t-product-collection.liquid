{% comment %}
  Website → Templates → Product page → "More from the collection" (product_collection).
  Other pieces from the product's signature collection, in a scrolling row; left out
  when the product is in none. The product being viewed is not in the row.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign signature = product.metafields.custom.signature_collection.value

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  assign heading = s.title
  if heading == blank
    assign heading = 'product.the_collection' | t
  endif
  assign view_all = ''
  if s.view_all
    assign view_all = signature.url
  endif

  capture look
    render 'sb-template-look', image_shape: s.image_shape, image_radius: s.image_radius, image_overlay: s.image_overlay, overlay_color: s.overlay_color, overlay_opacity: s.overlay_opacity, card_style: s.card_style, card_color: s.card_color, card_border_color: s.card_border_color, title_size: s.title_size, title_color: s.title_color, card_align: s.card_align
  endcapture
-%}

{%- if signature != blank -%}
  {%- capture row -%}
    {%- render 'sb-template-rail',
      heading: heading,
      products: signature.products,
      limit: s.limit,
      exclude: product.handle,
      view_all: view_all,
      view_all_label: s.view_all_label,
      placement: s.view_all_placement,
      per_desktop: s.per_desktop,
      per_tablet: s.per_tablet,
      per_mobile: s.per_mobile,
      step: s.step,
      look: look
    -%}
  {%- endcapture -%}
  {%- if row != blank -%}
    <div
      {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
      {% render 'sb-section-style', settings: s %}
      {{ section.shopify_attributes }}
    >
      {{- row -}}
    </div>
  {%- endif -%}
{%- endif -%}

