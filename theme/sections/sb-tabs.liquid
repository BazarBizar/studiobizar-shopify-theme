    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab name"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
