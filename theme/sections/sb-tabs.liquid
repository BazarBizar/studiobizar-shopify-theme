          "id": "link_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabs",
      "settings": {
        "title": "Materials"
      },
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "Wood",
            "title": "Solid oak and walnut",
            "body": "<p>Describe the material, where it comes from and how it ages.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Textile",
            "title": "Linen, wool and bouclé",
            "body": "<p>Describe the material, where it comes from and how it ages.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "Stone",
            "title": "Travertine and marble",
