        },
        {
          "value": "dark",
          "label": "Dark wood"
        },
        {
          "value": "olive",
          "label": "Black olive"
        },
        {
          "value": "blue",
          "label": "Charcoal blue"
        },
        {
          "value": "mocha",
          "label": "Deep mocha"
        },
        {
          "value": "black",
          "label": "Off-black"
        }
      ],
