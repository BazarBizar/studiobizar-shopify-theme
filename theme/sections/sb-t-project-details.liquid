{% comment %}
  Website → Templates → Project page → "Project story" (project_details). The name,
  subtitle, credits (location, year, creative lead, collaborators, photography), the
  story and the photo gallery — each part can be switched off.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign project = metaobject
  assign gallery = project.gallery.value

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  capture title_class
    render 'sb-template-heading', size: s.heading_size, align: s.heading_align, fallback: 'text-h1'
  endcapture

  assign above = false
  if s.credits_placement == 'above'
    assign above = true
  endif
-%}

{%- if project != blank -%}
  {%- capture credits -%}
    {%- if s.show_credits -%}
      {%- if project.location != blank -%}
        <div><dt class="text-secondary text-muted lowercase">{{ 'project.location' | t }}</dt><dd class="text-secondary mt-1 whitespace-pre-line">{{ project.location }}</dd></div>
      {%- endif -%}
      {%- if project.year != blank -%}
        <div><dt class="text-secondary text-muted lowercase">{{ 'project.year' | t }}</dt><dd class="text-secondary mt-1 whitespace-pre-line">{{ project.year }}</dd></div>
      {%- endif -%}
      {%- if project.creative_lead != blank -%}
        <div><dt class="text-secondary text-muted lowercase">{{ 'project.creative_lead' | t }}</dt><dd class="text-secondary mt-1 whitespace-pre-line">{{ project.creative_lead }}</dd></div>
      {%- endif -%}
      {%- if project.collaborators != blank -%}
        <div><dt class="text-secondary text-muted lowercase">{{ 'project.collaborators' | t }}</dt><dd class="text-secondary mt-1 whitespace-pre-line">{{ project.collaborators }}</dd></div>
      {%- endif -%}
      {%- if project.photography != blank -%}
        <div><dt class="text-secondary text-muted lowercase">{{ 'project.photography' | t }}</dt><dd class="text-secondary mt-1 whitespace-pre-line">{{ project.photography }}</dd></div>
      {%- endif -%}
    {%- endif -%}
  {%- endcapture -%}

  <div
    {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
    {% render 'sb-section-style', settings: s %}
    {{ section.shopify_attributes }}
  >
    <div class="sb-container py-section">
      <header class="max-w-[46rem]">
        <h1 class="{{ title_class }}"{% if s.heading_color != blank %} style="color: {{ s.heading_color }}"{% endif %}>{{ project.title }}</h1>
        {%- if s.show_subtitle and project.subtitle != blank -%}
          <p class="text-h2 mt-4 text-muted">{{ project.subtitle }}</p>
        {%- endif -%}
      </header>

      {%- if s.show_credits or s.show_body -%}
        <div class="{% if above %}mt-14 flex flex-col gap-10{% else %}mt-14 grid gap-12 lg:grid-cols-[20rem_1fr] lg:gap-20{% endif %}">
          {%- if credits != blank -%}
            <dl class="{% if above %}flex flex-wrap gap-x-12 gap-y-6{% else %}flex flex-col gap-6{% endif %}">{{ credits }}</dl>
          {%- endif -%}
          {%- if s.show_body and project.body != blank -%}
            <div class="sb-prose max-w-[38rem]">{{ project.body }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.show_gallery and gallery != blank and gallery.size > 0 -%}
        <div class="sb-masonry mt-16" data-sb-lightbox-group>
          {%- for entry in gallery -%}
            {%- if entry.image -%}
              {%- liquid
                assign alt = entry.alt_text | default: entry.caption | default: project.title
                assign full = entry.image | image_url: width: 2000
                assign open_label = 'gallery.open' | t: index: forloop.index, total: gallery.size
              -%}
              <figure>
                <button
                  type="button"
                  data-sb-lightbox-item
                  data-src="{{ full }}"
                  data-alt="{{ alt | escape }}"
                  data-caption="{{ entry.caption | escape }}"
                  data-credit="{{ entry.credit | escape }}"
                  aria-label="{{ open_label }}"
                  class="group block w-full overflow-hidden bg-foreground/10"
                >
                  {%- render 'sb-image',
                    image: entry.image,
                    alt: alt,
                    sizes: '(max-width: 749px) 100vw, (max-width: 1023px) 50vw, 33vw',
                    widths: '620, 830, 1240',
                    class: 'h-auto w-full transition-transform duration-500 ease-out-soft group-hover:scale-[1.02]'
                  -%}
                </button>
                {%- if entry.caption != blank -%}
                  <figcaption class="text-tertiary mt-2 text-muted">{{ entry.caption }}</figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- render 'sb-lightbox' -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

