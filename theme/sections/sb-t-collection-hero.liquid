{% comment %}
  Website → Templates → Collection page → "Collection photo and name" (collection_hero).
  The collection's large photograph with its logo — or its name in large letters —
  over it, on the dark ground the design gives it.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign m = collection.metafields.custom
  assign image = m.hero_image.value | default: collection.image
  assign logo = m.hero_logo.value
  assign wordmark = collection.title | remove_first: 'The ' | remove: ' Collection'
  assign hero_alt = image.alt | default: collection.title

  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  case s.height
    when 'short'
      assign height_class = 'min-h-[20rem] lg:min-h-[28rem]'
    when 'screen'
      assign height_class = 'min-h-svh'
    else
      assign height_class = 'min-h-[32rem] lg:min-h-[44rem]'
  endcase
  case s.name_size
    when 'display'
      assign name_class = 'text-display'
    when 'h1'
      assign name_class = 'text-h1'
    else
      assign name_class = 'text-display-lg'
  endcase

  assign tint = ''
  if s.overlay == 'color'
    assign tint_color = s.overlay_color
    if tint_color == blank
      assign tint_color = '#000000'
    endif
    assign tint = 'color-mix(in srgb, ' | append: tint_color | append: ' ' | append: s.overlay_opacity | append: '%, transparent)'
  endif
-%}

{%- if collection != blank -%}
  <div
    data-surface="dark"
    class="relative isolate flex items-center justify-center overflow-hidden {{ height_class }} {{ hide_class }}"
    {% render 'sb-section-style', settings: s %}
    {{ section.shopify_attributes }}
  >
    {%- if image -%}
      {%- render 'sb-image',
        image: image,
        alt: hero_alt,
        sizes: '100vw',
        widths: '830, 1240, 1660, 2400',
        priority: true,
        crop: 'center',
        class: 'absolute inset-0 -z-10 h-full w-full object-cover'
      -%}
    {%- endif -%}
    {%- if tint != '' -%}
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-[5]" style="background: {{ tint }}"></div>
    {%- endif -%}
    {%- if logo and s.logo -%}
      {%- render 'sb-image',
        image: logo,
        alt: collection.title,
        widths: '600, 1200',
        sizes: '60vw',
        class: 'h-auto w-[min(60vw,38rem)] object-contain'
      -%}
    {%- else -%}
      <h1
        class="{{ name_class }} px-gutter text-center leading-none tracking-[0.02em] text-foreground uppercase"
        {% if s.name_color != blank %}style="color: {{ s.name_color }}"{% endif %}
      >
        {{ wordmark }}
      </h1>
    {%- endif -%}
  </div>
{%- endif -%}

