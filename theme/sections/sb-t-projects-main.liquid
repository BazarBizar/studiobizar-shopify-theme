{% comment %}
  Website → Templates → All projects → "Projects with filters" (projects_main). The
  heading and intro, the category filter and the L / M view (read from the address,
  as sb-project-list does), then every project.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign projects = shop.metaobjects.project.values | sort: 'sort_order'

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  assign heading = s.title
  if heading == blank
    assign heading = 'project.title' | t
  endif
  capture title_class
    render 'sb-template-heading', size: s.heading_size, align: s.heading_align, fallback: 'text-h1'
  endcapture
  capture look
    render 'sb-template-look', columns_desktop: s.columns_desktop, columns_mobile: s.columns_mobile, gap: s.gap, image_shape: s.image_shape, image_radius: s.image_radius, image_overlay: s.image_overlay, overlay_color: s.overlay_color, overlay_opacity: s.overlay_opacity, card_style: s.card_style, card_color: s.card_color, card_border_color: s.card_border_color, title_size: s.title_size, title_color: s.title_color, card_align: s.card_align
  endcapture

  assign active_category = ''
  assign view = 'm'
  assign pairs = request.query_string | split: '&'
  for pair in pairs
    assign parts = pair | split: '='
    if parts[0] == 'category'
      assign active_category = parts[1] | replace: '+', ' ' | replace: '%20', ' '
    endif
    if parts[0] == 'view' and parts[1] == 'l'
      assign view = 'l'
    endif
  endfor

  assign categories = '|'
  for entry in projects
    if entry.category != blank
      assign probe = entry.category | prepend: '|' | append: '|'
      unless categories contains probe
        assign categories = categories | append: entry.category | append: '|'
      endunless
    endif
  endfor
  assign category_list = categories | split: '|' | compact

  assign category_param = ''
  if active_category != blank
    assign encoded_category = active_category | url_encode
    assign category_param = 'category=' | append: encoded_category | append: '&'
  endif
-%}

<div
  {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  {% render 'sb-section-style', settings: s %}
  {{ section.shopify_attributes }}
>
  <div class="sb-container pt-12 pb-section">
    <header class="max-w-[46rem]">
      <h1 class="{{ title_class }}"{% if s.heading_color != blank %} style="color: {{ s.heading_color }}"{% endif %}>{{ heading }}</h1>
      {%- if s.intro != blank -%}
        <p class="text-body mt-6 whitespace-pre-line">{{ s.intro | escape }}</p>
      {%- endif -%}
    </header>

    {%- if s.show_controls -%}
      <div class="mt-12 flex flex-wrap items-center justify-between gap-6 border-b border-border pb-4">
        {%- if category_list.size > 0 -%}
          <ul class="flex flex-wrap items-center gap-x-8 gap-y-3">
            <li>
              <a href="{{ request.path }}?view={{ view }}" class="text-secondary sb-underline{% if active_category == blank %} font-medium{% endif %}">{{ 'project.all' | t }}</a>
            </li>
            {%- for category in category_list -%}
              <li>
                <a
                  href="{{ request.path }}?category={{ category | url_encode }}&view={{ view }}"
                  {% if active_category == category %}aria-current="true"{% endif %}
                  class="text-secondary sb-underline{% if active_category == category %} font-medium{% endif %}"
                >{{ category | downcase }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <span></span>
        {%- endif -%}
        <div class="flex items-center gap-4">
          <span class="text-secondary">{{ 'project.view' | t }}:</span>
          <a href="{{ request.path }}?{{ category_param }}view=l" {% if view == 'l' %}aria-current="true"{% endif %} class="text-secondary sb-underline{% if view == 'l' %} font-medium{% endif %}">{{ 'project.view_l' | t }}</a>
          <a href="{{ request.path }}?{{ category_param }}view=m" {% if view == 'm' %}aria-current="true"{% endif %} class="text-secondary sb-underline{% if view == 'm' %} font-medium{% endif %}">{{ 'project.view_m' | t }}</a>
        </div>
      </div>
    {%- endif -%}

    {%- capture cards -%}
      {%- for entry in projects -%}
        {%- if active_category == blank or entry.category == active_category -%}
          {%- liquid
            assign eager = false
            if forloop.index0 < 3
              assign eager = true
            endif
          -%}
          <li>{%- render 'sb-project-card', project: entry, view: view, priority: eager -%}</li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if cards contains '<li>' -%}
      {%- if look != blank -%}<div {{ look }}>{%- endif -%}
      <ul class="{% if view == 'l' %}mt-10 flex flex-col gap-16{% else %}mt-10 grid gap-grid-gap gap-y-12 sm:grid-cols-2 lg:grid-cols-3{% endif %}">{{ cards }}</ul>
      {%- if look != blank -%}</div>{%- endif -%}
    {%- else -%}
      <p class="text-body py-16 text-muted">{{ 'project.none' | t }}</p>
    {%- endif -%}
  </div>
</div>

