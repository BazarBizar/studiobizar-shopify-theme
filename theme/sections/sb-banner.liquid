{% comment %}
  Image banner with copy — the page builder's `image_banner`
  (components/sections/landing/image-banner.tsx). A full-width photograph with a
  label, heading, text and up to two buttons placed on it.

  Not to be confused with `sb-image-banner`, which is the full-bleed image with
  no copy (the builder's `full_image`).

  The copy takes the tokens of the off-black or the earth surface (`tone`), so a
  button on it is the site's own button, inverted correctly — never a colour
  typed in. The schema below is GENERATED from lib/page-builder/sections-landing.ts
  by `yarn liquid:schemas`; change the section there, not here.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  case s.height
    when 'small'
      assign height_class = 'min-h-[24rem] sm:min-h-[45svh]'
    when 'medium'
      assign height_class = 'min-h-[30rem] sm:min-h-[65svh]'
    when 'screen'
      assign height_class = 'min-h-svh'
    when 'adapt'
      assign height_class = ''
      if s.image == blank
        assign height_class = 'min-h-[36rem] sm:min-h-[85svh]'
      endif
    else
      assign height_class = 'min-h-[36rem] sm:min-h-[85svh]'
  endcase

  capture position_class
    render 'sb-position-classes', position: s.position
  endcapture

  if s.tone == 'dark'
    assign tone_surface = 'light'
  else
    assign tone_surface = 'black'
  endif

  assign panel_class = ''
  if s.panel
    assign panel_class = 'bg-background max-w-[40rem] p-8 sm:p-12'
  endif

  assign first_band = false
  if section.index == 1
    assign first_band = true
  endif
-%}

<div
  class="bg-off-black relative isolate flex overflow-hidden {{ height_class }} {{ hide_class }}"
  {%- if s.height == 'adapt' and s.image != blank %} style="aspect-ratio: {{ s.image.aspect_ratio }};"{% endif %}
  {{ section.shopify_attributes }}
>
  {%- render 'sb-cover-image', image: s.image, mobile_image: s.mobile_image, priority: first_band -%}
  {%- if s.image != blank and s.overlay > 0 -%}
    <div aria-hidden="true" class="bg-off-black absolute inset-0" style="opacity: {{ s.overlay | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div
    data-surface="{{ tone_surface }}"
    class="sb-container py-section text-foreground relative flex w-full flex-col {% if s.height == 'adapt' %}max-sm:min-h-[30rem] {% endif %}{{ position_class }}"
  >
    {%- render 'sb-landing-copy',
      eyebrow: s.eyebrow,
      heading: s.title,
      body: s.body,
      heading_size: s.heading_size,
      primary_label: s.primary_label,
      primary_url: s.primary_url,
      primary_style: s.primary_style,
      secondary_label: s.secondary_label,
      secondary_url: s.secondary_url,
      secondary_style: s.secondary_style,
      align: s.align,
      class: panel_class
    -%}
  </div>
</div>

