{% comment %}
  Website → Templates → Collection page → "Projects with this collection"
  (collection_in_context). The projects chosen on the collection (`in_context_projects`),
  edge to edge in a scrolling row on charcoal blue; left out when none are chosen.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign projects = collection.metafields.custom.in_context_projects.value

  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  assign heading = s.title
  if heading == blank
    assign heading = 'collection.in_context' | t
  endif

  capture title_class
    render 'sb-template-heading', size: s.heading_size, align: s.heading_align, fallback: 'text-h2'
  endcapture
  capture look
    render 'sb-template-look', image_shape: s.image_shape, image_radius: s.image_radius, image_overlay: s.image_overlay, overlay_color: s.overlay_color, overlay_opacity: s.overlay_opacity, card_style: s.card_style, card_color: s.card_color, card_border_color: s.card_border_color, title_size: s.title_size, title_color: s.title_color, card_align: s.card_align
  endcapture

  assign label_previous = 'sections.slideshow.previous' | t
  assign label_next = 'sections.slideshow.next' | t
-%}

{%- if projects != blank and projects.size > 0 -%}
  <div
    data-surface="blue"
    class="bg-background py-section text-foreground {{ hide_class }}"
    {% render 'sb-section-style', settings: s %}
    {{ section.shopify_attributes }}
  >
    <div class="sb-container">
      <h2 class="{{ title_class }} mb-8"{% if s.heading_color != blank %} style="color: {{ s.heading_color }}"{% endif %}>{{ heading }}</h2>
    </div>
    {%- if look != blank -%}<div {{ look }}>{%- endif -%}
    <div data-sb-carousel role="region" aria-roledescription="carousel" aria-label="{{ heading | escape }}">
      <div class="sb-track" data-sb-carousel-track>
        {%- for entry in projects -%}
          {%- assign image = entry.card_image.value | default: entry.hero_image.value -%}
          <div class="min-w-0 shrink-0 basis-full! sm:basis-1/2! lg:basis-1/3!">
            <a href="{{ entry.system.url }}" class="group block">
              <div class="relative aspect-3/4 overflow-hidden bg-foreground/10">
                {%- if image -%}
                  {%- render 'sb-image',
                    image: image,
                    alt: entry.title,
                    sizes: '(max-width: 749px) 100vw, (max-width: 1023px) 50vw, 33vw',
                    class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-[1.03]'
                  -%}
                {%- endif -%}
              </div>
              <div class="px-gutter mt-3">
                <h3 class="text-h4">{{ entry.title }}</h3>
                {%- if entry.location != blank -%}
                  <p class="text-secondary text-muted italic">{{ entry.location }}</p>
                {%- endif -%}
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
      <div data-sb-carousel-controls hidden class="sb-container mt-6 flex justify-end gap-1">
        <button type="button" data-sb-carousel-prev aria-label="{{ label_previous }}" class="flex size-9 items-center justify-center opacity-80 hover:opacity-100">
          {%- render 'sb-icon', icon: 'arrow-left', class: 'size-5', size: 1.25 -%}
        </button>
        <button type="button" data-sb-carousel-next aria-label="{{ label_next }}" class="flex size-9 items-center justify-center opacity-80 hover:opacity-100">
          {%- render 'sb-icon', icon: 'arrow-right', class: 'size-5', size: 1.25 -%}
        </button>
      </div>
    </div>
    {%- if look != blank -%}</div>{%- endif -%}
  </div>
{%- endif -%}

