{% comment %}
  Website → Templates → Designer page → "Designer profile" (designer_profile). The
  portrait beside the name, studio, line and biography, then the collections that
  credit the designer.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign designer = metaobject
  assign portrait = designer.portrait.value
  assign portrait_alt = portrait.alt | default: designer.name
  assign bio = designer.bio_full.value

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  capture title_class
    render 'sb-template-heading', size: s.heading_size, align: s.heading_align, fallback: 'text-h2'
  endcapture

  case s.portrait_shape
    when 'square'
      assign shape_class = 'aspect-square'
    when 'portrait'
      assign shape_class = 'aspect-[3/4]'
    when 'landscape'
      assign shape_class = 'aspect-[4/3]'
    else
      assign shape_class = 'aspect-[619/728]'
  endcase

  comment
    The collections that credit this designer — an identity check on the metaobject,
    not a name match (see sb-main-designer).
  endcomment
  assign credited = ''
  if s.show_collections
    for item in collections
      assign credit = item.metafields.custom.designer.value
      if credit != blank and credit.system.id == designer.system.id
        assign credited = credited | append: item.handle | append: ','
      endif
    endfor
  endif
  assign credited_handles = credited | split: ','
-%}

{%- if designer != blank -%}
  <div
    {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
    {% render 'sb-section-style', settings: s %}
    {{ section.shopify_attributes }}
  >
    <div class="sb-container pt-12 pb-section">
      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
        {%- if portrait -%}
          <figure
            class="relative w-full overflow-hidden bg-foreground/10 {{ shape_class }}{% if s.align == 'right' %} lg:order-last{% endif %}"
            {% if s.portrait_radius > 0 %}style="border-radius: {{ s.portrait_radius }}px"{% endif %}
          >
            {%- render 'sb-image',
              image: portrait,
              alt: portrait_alt,
              sizes: '(max-width: 1023px) 100vw, 45vw',
              widths: '620, 830, 1240',
              priority: true,
              crop: 'center',
              class: 'absolute inset-0 h-full w-full object-cover'
            -%}
          </figure>
        {%- endif -%}

        <div class="max-w-[34rem]">
          <h1 class="{{ title_class }}"{% if s.heading_color != blank %} style="color: {{ s.heading_color }}"{% endif %}>{{ designer.name }}</h1>
          {%- if designer.studio != blank and designer.studio != designer.name -%}
            <p class="text-secondary mt-1 text-muted">{{ designer.studio }}</p>
          {%- endif -%}
          {%- if designer.byline != blank -%}
            <p class="text-h3 mt-6">{{ designer.byline }}</p>
          {%- endif -%}
          {%- if bio != blank -%}
            <div class="sb-prose mt-6">{{ bio }}</div>
          {%- elsif designer.bio_short != blank -%}
            <p class="text-body mt-6">{{ designer.bio_short }}</p>
          {%- endif -%}

          {%- if credited_handles.size > 0 -%}
            <p class="text-secondary mt-8 text-muted">
              {{ 'designer.collections' | t }}:
              {%- for handle in credited_handles -%}
                {%- assign item = collections[handle] -%}
                {% if forloop.index0 > 0 %}, {% endif %}
                <a href="{{ item.url }}" class="sb-underline">{{ item.title }}</a>
              {%- endfor -%}
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

