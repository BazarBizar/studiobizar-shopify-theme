{% comment %}
  Website → Templates → Project page → "Project photo" (project_hero). The project's
  main photograph, the full width of the page; left out when it has none.
  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign project = metaobject
  assign hero = project.hero_image.value
  assign hero_alt = hero.alt | default: project.title

  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  case s.height
    when 'wide'
      assign shape_class = 'aspect-[16/9]'
    when 'screen'
      assign shape_class = 'h-svh'
    else
      assign shape_class = 'aspect-[2/3] sm:aspect-[16/10] lg:aspect-[16/8]'
  endcase

  assign tint = ''
  if s.overlay == 'color'
    assign tint_color = s.overlay_color
    if tint_color == blank
      assign tint_color = '#000000'
    endif
    assign tint = 'color-mix(in srgb, ' | append: tint_color | append: ' ' | append: s.overlay_opacity | append: '%, transparent)'
  endif
-%}

{%- if hero -%}
  <div
    class="relative w-full overflow-hidden {{ shape_class }} {{ hide_class }}"
    {% render 'sb-section-style', settings: s %}
    {{ section.shopify_attributes }}
  >
    {%- render 'sb-image',
      image: hero,
      alt: hero_alt,
      sizes: '100vw',
      widths: '830, 1240, 1660, 2400',
      priority: true,
      crop: 'center',
      class: 'absolute inset-0 h-full w-full object-cover'
    -%}
    {%- if tint != '' -%}
      <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background: {{ tint }}"></div>
    {%- endif -%}
  </div>
{%- endif -%}

