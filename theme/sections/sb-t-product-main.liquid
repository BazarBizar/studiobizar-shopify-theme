{% comment %}
  Website → Templates → Product page → "Product details" (product_main in
  lib/page-builder/sections-template.ts; drawn in Next by renderers-template.tsx).

  The photos beside the product's parts. Each part is a block, in the order the
  merchant puts them; a part whose field is empty on this product draws nothing, as
  on the route. NO PRICE, NO STOCK: "Price on request" stands where a price would.

  The schema is generated (`yarn liquid:schemas`); change the section in Next.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign m = product.metafields.custom

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture
  assign paints = false
  if s.surface != blank and s.surface != 'inherit'
    assign paints = true
  endif

  assign availability = m.availability.value
  assign lead_time = m.lead_time_weeks.value
  if availability != blank and lead_time != blank
    assign availability = availability | append: ' | ' | append: lead_time
  endif
  assign designer = m.designer.value
  assign details = shop.metafields.custom.product_details.value

  comment
    The photos' share of the row; with the photos on the right, the columns swap.
  endcomment
  assign right = false
  if s.gallery_position == 'right'
    assign right = true
  endif
  case s.gallery_width
    when 'wide'
      if right
        assign columns_class = 'lg:grid-cols-[2fr_3fr]'
      else
        assign columns_class = 'lg:grid-cols-[3fr_2fr]'
      endif
    when 'narrow'
      if right
        assign columns_class = 'lg:grid-cols-[3fr_2fr]'
      else
        assign columns_class = 'lg:grid-cols-[2fr_3fr]'
      endif
    else
      assign columns_class = 'lg:grid-cols-2'
  endcase
  case s.column_gap
    when 'tight'
      assign gap_class = 'gap-8 lg:gap-8'
    when 'roomy'
      assign gap_class = 'gap-16 lg:gap-28'
    else
      assign gap_class = 'gap-12 lg:gap-16'
  endcase

  capture title_class
    render 'sb-template-heading', size: s.heading_size, align: s.heading_align, fallback: 'text-h1'
  endcapture

  assign t_downloads = 'product.downloads' | t
  assign t_panel_tech = 'product.panel.technical_specifications' | t
  assign t_panel_dimensions = 'product.panel.dimensions' | t
  assign t_panel_care = 'product.panel.care_maintenance' | t
  assign t_panel_shipping = 'product.panel.shipping_delivery' | t
-%}

{%- if product != blank -%}
<div
  {% if paints %}data-surface="{{ s.surface }}" {% endif %}class="{% if paints %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  data-sb-product
  {% render 'sb-section-style', settings: s %}
  {{ section.shopify_attributes }}
>
  <div class="sb-container pt-8 pb-section">
    <div class="grid {{ gap_class }} {{ columns_class }}">
      {%- render 'sb-product-gallery', product: product -%}

      <div class="max-w-[35rem]{% if right %} lg:order-first{% endif %}{% if s.sticky %} lg:sticky lg:top-24 lg:self-start{% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'breadcrumb' -%}
              <nav aria-label="Breadcrumb" class="text-tertiary font-medium tracking-[0.02em] text-muted uppercase" {{ block.shopify_attributes }}>
                <a href="{{ routes.all_products_collection_url }}" class="sb-underline">{{ 'product.breadcrumb_root' | t }}</a>
                {%- if product.type != blank -%}
                  <span aria-hidden="true"> &gt; </span>
                  <span>{{ product.type }}</span>
                {%- endif -%}
              </nav>

            {%- when 'title' -%}
              <h1 class="{{ title_class }} mt-4"{% if s.heading_color != blank %} style="color: {{ s.heading_color }}"{% endif %} {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'designer' -%}
              {%- if designer.name != blank -%}
                {%- assign prefix = block.settings.prefix | strip -%}
                <p class="text-h2 mt-3 text-muted" {{ block.shopify_attributes }}>
                  {%- if prefix != blank %}{{ prefix }} {% endif -%}
                  {{- designer.name -}}
                  {%- if designer.studio != blank %}, {{ designer.studio }}{% endif -%}
                </p>
              {%- endif -%}

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="sb-prose mt-8" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'in_context' -%}
              {%- if m.in_context_images.value != blank -%}
                <div class="mt-8 border-t border-border pt-8" {{ block.shopify_attributes }}>
                  <ul class="grid grid-cols-3 gap-grid-gap">
                    {%- for entry in m.in_context_images.value -%}
                      {%- if entry.image -%}
                        {%- assign entry_alt = entry.alt_text | default: product.title -%}
                        <li>
                          <figure>
                            {%- render 'sb-image', image: entry.image, alt: entry_alt, ratio: '1 / 1', crop: 'center', sizes: '(max-width: 1023px) 33vw, 15vw' -%}
                            {%- if entry.caption != blank -%}
                              <figcaption class="text-tertiary mt-2 text-muted">{{ entry.caption }}</figcaption>
                            {%- endif -%}
                          </figure>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

            {%- when 'specs' -%}
              {%- capture specs -%}
                {%- if details.rows -%}
                  {%- for row in details.rows -%}
                    {%- liquid
                      if row.key == 'availability'
                        assign row_value = availability
                      else
                        assign row_value = m[row.key].value
                      endif
                    -%}
                    {%- if row_value != blank -%}
                      <div class="grid grid-cols-[10rem_1fr] gap-4"><dt class="text-h4">{{ row.label }}</dt><dd class="text-tertiary">{{ row_value }}</dd></div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- if m.material_finish.value != blank -%}
                    <div class="grid grid-cols-[10rem_1fr] gap-4"><dt class="text-h4">{{ 'product.spec.material_finish' | t }}</dt><dd class="text-tertiary">{{ m.material_finish.value }}</dd></div>
                  {%- endif -%}
                  {%- if m.colour.value != blank -%}
                    <div class="grid grid-cols-[10rem_1fr] gap-4"><dt class="text-h4">{{ 'product.spec.colour' | t }}</dt><dd class="text-tertiary">{{ m.colour.value }}</dd></div>
                  {%- endif -%}
                  {%- if m.upholstery.value != blank -%}
                    <div class="grid grid-cols-[10rem_1fr] gap-4"><dt class="text-h4">{{ 'product.spec.upholstery' | t }}</dt><dd class="text-tertiary">{{ m.upholstery.value }}</dd></div>
                  {%- endif -%}
                  {%- if availability != blank -%}
                    <div class="grid grid-cols-[10rem_1fr] gap-4"><dt class="text-h4">{{ 'product.spec.availability' | t }}</dt><dd class="text-tertiary">{{ availability }}</dd></div>
                  {%- endif -%}
                {%- endif -%}
              {%- endcapture -%}
              {%- if specs contains '<dt' -%}
                <dl class="mt-12 flex flex-col gap-3" {{ block.shopify_attributes }}>{{ specs }}</dl>
              {%- endif -%}

            {%- when 'price' -%}
              <p class="text-h4 mt-10 border-t border-border pt-10 italic" {{ block.shopify_attributes }}>{{ 'product.price_on_request' | t }}</p>

            {%- when 'inquiry' -%}
              <div class="mt-5" {{ block.shopify_attributes }}>{%- render 'sb-add-to-inquiry', product: product -%}</div>

            {%- when 'panels' -%}
              {%- capture panels -%}
                {%- if details.panels -%}
                  {%- for panel in details.panels -%}
                    {%- if m[panel.key].value != blank -%}
                      {%- render 'sb-accordion', title: panel.label, content: m[panel.key].value -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- if m.technical_specifications.value != blank -%}
                    {%- render 'sb-accordion', title: t_panel_tech, content: m.technical_specifications.value -%}
                  {%- endif -%}
                  {%- if m.dimensions.value != blank -%}
                    {%- render 'sb-accordion', title: t_panel_dimensions, content: m.dimensions.value -%}
                  {%- endif -%}
                  {%- if m.care_maintenance.value != blank -%}
                    {%- render 'sb-accordion', title: t_panel_care, content: m.care_maintenance.value -%}
                  {%- endif -%}
                  {%- if m.shipping_delivery.value != blank -%}
                    {%- render 'sb-accordion', title: t_panel_shipping, content: m.shipping_delivery.value -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if block.settings.downloads and m.downloads.value != blank -%}
                  {%- capture downloads -%}
                    <ul class="flex flex-col gap-2">
                      {%- for file in m.downloads.value -%}
                        {%- liquid
                          assign filename = file.url | split: '/' | last | split: '?' | first
                          if filename == blank
                            assign filename = 'product.download_fallback' | t
                          endif
                        -%}
                        <li><a href="{{ file.url }}" target="_blank" rel="noopener noreferrer" class="text-secondary sb-underline">{{ filename }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endcapture -%}
                  {%- render 'sb-accordion', title: t_downloads, content: downloads -%}
                {%- endif -%}
              {%- endcapture -%}
              {%- if panels != blank -%}
                <div class="mt-12" {{ block.shopify_attributes }}>{{ panels }}</div>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.body != blank -%}
                <div class="sb-prose mt-8" {{ block.shopify_attributes }}>{{ block.settings.body }}</div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
