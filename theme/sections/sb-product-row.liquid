{% comment %}
  A titled row of products.

  NAMED `sb-product-row`, NOT `sb-product-rail`. Sections and snippets are
  separate namespaces in Shopify, so a section and a snippet may share a name —
  and `{% render 'sb-product-rail' %}` inside a section of the same name resolves
  to the snippet, which reads like a bug even when it is not. The section is the
  theme-editor wrapper; the snippet is the markup it renders.

  A titled row of products — New In and Monthly Selection on the landing page,
  from app/(storefront)/page.tsx.

  The collection is either named by a PAGE METAFIELD (`new_in`,
  `monthly_selection` — how the landing page does it, so the choice stays with
  whoever edits content) or picked directly in the theme editor. The metafield
  wins when it resolves, which keeps the existing content working untouched.

  Renders nothing when neither resolves, so a page that has not set the metafield
  shows no empty band.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture

  assign paints_ground = true
  if s.surface == 'inherit'
    assign paints_ground = false
  endif

  comment
    WHICH PAGE THE METAFIELDS COME FROM.

    `page` is EMPTY on the index template — a Shopify home page is not a page
    object, and the Next build reached its content with an explicit
    getPage("home"). So the source is a named handle when one is set, and the
    page being viewed otherwise. Without this the landing page rendered its
    sections with nothing in them, which is how the dev server found it.
  endcomment
  assign source_page = page
  if s.page_handle != blank
    assign source_page = pages[s.page_handle]
  endif

  assign source = blank
  if s.metafield != 'none'
    assign source = source_page.metafields.custom[s.metafield].value
  endif
  if source == blank
    assign source = s.collection
  endif
-%}

{%- if source != blank and source.products_count > 0 -%}
  <section
    {% if paints_ground %}data-surface="{{ s.surface }}" class="bg-background text-foreground"{% endif %}
    {{ section.shopify_attributes }}
  >
    <div class="{{ rhythm_class }}">
      {%- render 'sb-product-rail',
        heading: s.heading,
        products: source.products,
        view_all: source.url,
        limit: s.limit
      -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product row",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New In"
    },
    {
      "type": "select",
      "id": "metafield",
      "label": "Collection from a page metafield",
      "info": "Used when it resolves. Falls back to the picker below.",
      "options": [
        { "value": "new_in", "label": "new_in" },
        { "value": "monthly_selection", "label": "monthly_selection" },
        { "value": "none", "label": "None — use the picker" }
      ],
      "default": "new_in"
    },
    {
      "type": "text",
      "id": "page_handle",
      "label": "Read metafields from this page",
      "info": "Leave empty to use the page being viewed. The home template has no page of its own, so it names one \u2014 usually `home`."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products shown",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Ground",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "light", "label": "Earth" },
        { "value": "dark", "label": "Dark wood" },
        { "value": "olive", "label": "Black olive" },
        { "value": "blue", "label": "Charcoal blue" },
        { "value": "mocha", "label": "Deep mocha" },
        { "value": "black", "label": "Off black" }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "rhythm",
      "label": "Vertical space",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "xs", "label": "Extra tight" },
        { "value": "sm", "label": "Tight" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Loose" },
        { "value": "xl", "label": "Extra loose" }
      ],
      "default": "theme"
    }
  ],
  "presets": [
    {
      "name": "Product row"
    }
  ]
}
{% endschema %}
