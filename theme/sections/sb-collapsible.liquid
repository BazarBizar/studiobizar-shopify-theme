{% comment %}
  Collapsible content — the page builder's `collapsible`
  (components/sections/landing/collapsible.tsx). Rows that open on click, beside
  an optional image. Native <details>: no script, keyboard and screen readers
  handled by the browser, content in the HTML for search engines.

  The schema below is GENERATED from lib/page-builder/sections-landing.ts by
  `yarn liquid:schemas`; change the section there, not here.
{% endcomment %}

{%- liquid
  assign s = section.settings

  capture rhythm_class
    render 'sb-section-classes', rhythm: s.rhythm, pad: 'none'
  endcapture
  capture hide_class
    render 'sb-hide-on', hide_on: s.hide_on
  endcapture

  assign count = 0
  for block in section.blocks
    if block.settings.heading != blank
      assign count = count | plus: 1
    endif
  endfor

  assign with_image = false
  if s.image != blank or request.design_mode
    assign with_image = true
  endif
-%}

<div
  {% if s.surface != 'inherit' %}data-surface="{{ s.surface }}"{% endif %}
  class="{% if s.surface != 'inherit' %}flow-root bg-background text-foreground {% endif %}{{ rhythm_class }} {{ hide_class }}"
  {% render 'sb-section-style', settings: s %}
  {{ section.shopify_attributes }}
>
  {%- if count > 0 -%}
    {%- capture rows -%}
      <div class="border-border border-t">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- if b.heading == blank -%}{%- continue -%}{%- endif -%}
          {%- assign n = n | plus: 1 -%}
          <details class="group border-border border-b"{% if s.open_first and n == 1 %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="text-h4 flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-medium [&::-webkit-details-marker]:hidden">
              {{ b.heading }}
              {%- render 'sb-icon', icon: 'plus', class: 'size-4 shrink-0 transition-transform group-open:rotate-45' -%}
            </summary>
            {%- if b.body != blank -%}
              <div class="sb-prose max-w-[44rem] pb-6" style="font-size: var(--fs-secondary);">{{ b.body }}</div>
            {%- endif -%}
          </details>
        {%- endfor -%}
      </div>
    {%- endcapture -%}

    <div class="sb-container py-section">
      {%- render 'sb-section-header', heading: s.title, intro: s.intro, align: s.heading_align -%}
      {%- if with_image -%}
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-20{% if s.image_side == 'right' %} lg:[&>*:first-child]:order-2{% endif %}">
          {%- render 'sb-picture', image: s.image, ratio: 'portrait', sizes: '(max-width: 1023px) 100vw, 45vw' -%}
          <div class="lg:pt-2">{{ rows }}</div>
        </div>
      {%- else -%}
        <div class="max-w-[56rem]">{{ rows }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

