{% comment %}
  The page builder's "Show on" setting (`hideOn`), as a class.
  Stored as where the band is HIDDEN: none | mobile | desktop.
  The classes are written out in full so Tailwind finds them — see sb-section-classes.
{% endcomment %}

{%- case hide_on -%}
  {%- when 'mobile' -%}max-sm:hidden
  {%- when 'desktop' -%}sm:hidden
{%- endcase -%}
