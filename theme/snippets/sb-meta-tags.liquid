{% comment %}
  Open Graph and Twitter cards.

  The Next build generated these from each route's `metadata` export. Shopify
  has no equivalent hook, so they are assembled here from whatever object the
  template is rendering.

  NO PRICE. The og:product tags Shopify's own themes emit (og:price:amount,
  og:price:currency, og:availability) are deliberately absent: this storefront
  is a catalogue, and a price leaking into a link preview would contradict every
  page it points at. scripts/check-no-price.ts enforces the same rule on the
  Next side — see the note at the top of lib/shopify/fragments.ts.
{% endcomment %}

{%- liquid
  if template.name == 'product'
    assign og_type = 'product'
    assign og_title = product.title
    assign og_description = product.description | strip_html
    assign og_image = product.featured_image
  elsif template.name == 'collection'
    assign og_type = 'website'
    assign og_title = collection.title
    assign og_description = collection.description | strip_html
    assign og_image = collection.image
  elsif template.name == 'article'
    assign og_type = 'article'
    assign og_title = article.title
    assign og_description = article.excerpt_or_content | strip_html
    assign og_image = article.image
  else
    assign og_type = 'website'
    assign og_title = page_title
    assign og_description = page_description
  endif

  assign og_description = og_description | default: shop.description | default: shop.name
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image -%}
  <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  {%- if og_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
