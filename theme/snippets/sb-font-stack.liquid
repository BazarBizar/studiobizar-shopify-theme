{% comment %}
  GENERATED by `yarn liquid:design` from lib/page-builder/design-style.ts — do not edit.
  A font id from the page builder's list → the CSS stack `fontStack` writes in Next.
{% endcomment %}
{%- liquid
  case id
    when 'inter'
      echo "'Inter Variable', var(--font-body)"
    when 'dm-sans'
      echo "'DM Sans Variable', var(--font-body)"
    when 'manrope'
      echo "'Manrope Variable', var(--font-body)"
    when 'work-sans'
      echo "'Work Sans Variable', var(--font-body)"
    when 'space-grotesk'
      echo "'Space Grotesk Variable', var(--font-body)"
    when 'syne'
      echo "'Syne Variable', var(--font-body)"
    when 'playfair-display'
      echo "'Playfair Display Variable', Georgia, serif"
    when 'cormorant-garamond'
      echo "'Cormorant Garamond Variable', Georgia, serif"
    when 'fraunces'
      echo "'Fraunces Variable', Georgia, serif"
    when 'eb-garamond'
      echo "'EB Garamond Variable', Georgia, serif"
  endcase
-%}
