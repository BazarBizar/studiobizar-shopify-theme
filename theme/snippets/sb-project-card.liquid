{% comment %}
  components/project/project-card.tsx — the two densities from
  `DESK - Projects Overview (View L/M).pdf`.

  `l` is one full-bleed project per row on 5:3; `m` is three across on 2:3. Same
  card, same data — only the media aspect and the type scale change.

  Both collapse to the 3:4 measured on the 393px frames: one card per row at
  353×467, whichever density the desktop view asked for.

  Accepts:
    project  — a `project` metaobject
    view     — l | m, default m
    priority — true above the fold
{% endcomment %}

{%- liquid
  assign image = project.card_image.value | default: project.hero_image.value
  assign card_alt = image.alt | default: project.title

  assign large = false
  if view == 'l'
    assign large = true
  endif

  comment
    Both class strings are written out whole rather than composed, so Tailwind
    can see them while scanning. A `sm:aspect-[{{ ... }}]` would never be emitted.
  endcomment
  if large
    assign media_class = 'relative aspect-[3/4] overflow-hidden bg-foreground/5 sm:aspect-[5/3]'
    assign title_class = 'mt-3 text-h2'
    assign card_sizes = '100vw'
  else
    assign media_class = 'relative aspect-[3/4] overflow-hidden bg-foreground/5 sm:aspect-[2/3]'
    assign title_class = 'mt-3 text-h3'
    assign card_sizes = '(max-width: 749px) 100vw, 33vw'
  endif
-%}

<article>
  <a href="{{ project.system.url }}" class="group block">
    <div class="{{ media_class }}">
      {%- if image -%}
        {%- render 'sb-image',
          image: image,
          alt: card_alt,
          sizes: card_sizes,
          priority: priority,
          crop: 'center',
          class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out-soft group-hover:scale-[1.02]'
        -%}
      {%- endif -%}
    </div>

    <h2 class="{{ title_class }}">{{ project.title }}</h2>
    {%- if project.location != blank -%}
      <p class="text-secondary mt-1 text-muted">{{ project.location }}</p>
    {%- endif -%}
  </a>
</article>
