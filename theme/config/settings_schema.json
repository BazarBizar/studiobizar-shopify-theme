[
  {
    "name": "theme_info",
    "theme_name": "Studio Bizar",
    "theme_version": "1.0.0",
    "theme_author": "Studio Bizar",
    "theme_documentation_url": "https://github.com/studiobizar",
    "theme_support_url": "https://github.com/studiobizar"
  },

  {
    "name": "Brand",
    "settings": [
      {
        "type": "paragraph",
        "content": "The logo and mark are vector paths extracted from the Figma frames and shipped in assets/ (sb-logo.svg, sb-mark.svg). They are drawn as a CSS mask so they recolour with the surface, which an image setting cannot do — replace the files themselves to change the lockup."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "color",
        "id": "meta_theme_color",
        "label": "Browser chrome colour",
        "info": "The tint mobile browsers paint around the page.",
        "default": "#EBE8E3"
      }
    ]
  },

  {
    "name": "Colour",
    "settings": [
      {
        "type": "paragraph",
        "content": "Six grounds, each read out of the Figma content streams rather than sampled by eye. Everything else in the theme — body copy, borders, buttons, muted text — is derived from these in CSS, so changing one value moves every surface that uses it."
      },
      {
        "type": "color",
        "id": "color_earth",
        "label": "Earth",
        "info": "Primary ground; text colour on dark pages.",
        "default": "#EBE8E3"
      },
      {
        "type": "color",
        "id": "color_dark_wood",
        "label": "Dark wood",
        "info": "Body copy, and the ground of the landing page.",
        "default": "#302F2D"
      },
      {
        "type": "color",
        "id": "color_black_olive",
        "label": "Black olive",
        "info": "Footer ground on 11 of the 14 designs.",
        "default": "#41473E"
      },
      {
        "type": "color",
        "id": "color_charcoal_blue",
        "label": "Charcoal blue",
        "info": "Collections detail, Services, Our Story.",
        "default": "#47515C"
      },
      {
        "type": "color",
        "id": "color_deep_mocha",
        "label": "Deep mocha",
        "info": "Contact and Designers.",
        "default": "#4A3C3F"
      },
      {
        "type": "color",
        "id": "color_off_black",
        "label": "Off black",
        "info": "Gallery and project detail.",
        "default": "#1D1D1B"
      }
    ]
  },

  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Helvetica Neue is a licensed Linotype face, so it cannot be served from a font service and does not appear in Shopify's font list. Until the webfont files are uploaded it renders natively on macOS and iOS and falls back to Arial elsewhere — metrically compatible, so the layout holds."
      },
      {
        "type": "text",
        "id": "font_body_woff2",
        "label": "Regular .woff2 filename",
        "info": "The file must be uploaded to the theme's assets folder. Example: HelveticaNeue-Regular.woff2"
      },
      {
        "type": "text",
        "id": "font_body_medium_woff2",
        "label": "Medium .woff2 filename",
        "info": "Optional. Used for buttons and footer headings."
      },
      {
        "type": "range",
        "id": "type_scale",
        "label": "Type scale — desktop",
        "info": "Multiplies the whole ladder at once, keeping its proportions. 1.0 is the measured size.",
        "min": 0.8,
        "max": 1.3,
        "step": 0.1,
        "default": 1
      },
      {
        "type": "range",
        "id": "type_scale_mobile",
        "label": "Type scale — 749px and below",
        "min": 0.8,
        "max": 1.3,
        "step": 0.1,
        "default": 1
      }
    ]
  },

