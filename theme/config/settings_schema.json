  {
    "name": "Layout",
    "settings": [
      {
        "type": "paragraph",
        "content": "Measured from the Shop All product grid on the 1728px canvas. Content deliberately runs edge to edge — it is not capped at the canvas width, because centring at 1728px leaves five times the design's margin on a 1920 display."
      },
      {
        "type": "range",
        "id": "layout_gutter",
        "label": "Page gutter",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "layout_grid_gap",
        "label": "Grid gap",
        "info": "Between product and collection cards.",
        "min": 0,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 10
      },
      {
        "type": "select",
        "id": "layout_section_rhythm",
        "label": "Default section rhythm",
        "info": "The vertical air between bands. Any section can override this on itself.",
        "options": [
          { "value": "xs", "label": "Extra tight (24 – 40px)" },
          { "value": "sm", "label": "Tight (40 – 64px)" },
          { "value": "md", "label": "Medium (56 – 104px)" },
          { "value": "lg", "label": "Loose (80 – 144px)" },
          { "value": "xl", "label": "Extra loose (176px, as measured)" }
        ],
        "default": "md"
      },
      {
        "type": "select",
        "id": "layout_card_ratio",
        "label": "Product card ratio",
        "info": "The Figma card media frame is 415 × 519, which is 4:5.",
        "options": [
          { "value": "4 / 5", "label": "4:5 — as measured" },
          { "value": "1 / 1", "label": "1:1 — square" },
          { "value": "3 / 4", "label": "3:4" },
          { "value": "3 / 5", "label": "3:5 — tall" },
          { "value": "16 / 9", "label": "16:9 — wide" }
        ],
        "default": "4 / 5"
      },
      {
        "type": "select",
        "id": "page_surface",
        "label": "Base page ground",
        "info": "What shows between and below sections. Each section picks its own ground on top of this.",
        "options": [
          { "value": "light", "label": "Earth" },
          { "value": "dark", "label": "Dark wood" },
          { "value": "olive", "label": "Black olive" },
          { "value": "blue", "label": "Charcoal blue" },
          { "value": "mocha", "label": "Deep mocha" },
          { "value": "black", "label": "Off black" }
        ],
        "default": "light"
      }
    ]
  },

  {
    "name": "Motion",
    "settings": [
      {
        "type": "paragraph",
        "content": "Short and ease-out, nothing decorative. Visitors who ask their system for reduced motion get none of it, regardless of this setting."
      },
      {
        "type": "range",
        "id": "motion_duration",
        "label": "Base duration",
        "info": "The fast and slow durations scale with this. 0 turns transitions off.",
        "min": 0,
        "max": 600,
        "step": 10,
        "unit": "ms",
        "default": 220
      }
    ]
  },

  {
    "name": "Social",
    "settings": [
      {
        "type": "paragraph",
        "content": "Six marks in a 2×3 grid, extracted as SVG from the Figma frames. Only Instagram, Facebook and Pinterest are confirmed — the Contact page names all three as @studiobizarantwerp. A mark with no URL renders dimmed rather than guessing a destination."
      },
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_pinterest", "label": "Pinterest" },
      { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
      {
        "type": "url",
        "id": "social_five",
        "label": "Fifth channel",
        "info": "Platform unconfirmed — the glyph was read off the design, not named in it."
      },
      { "type": "url", "id": "social_six", "label": "Sixth channel" }
    ]
  },

  {
    "name": "Inquiry",
    "settings": [
      {
        "type": "paragraph",
        "content": "This storefront has no price, no stock and no checkout. Visitors collect products into an inquiry list held in their browser, then submit it. The submission is written to Shopify as a metaobject, turned into a PDF and emailed — none of which a theme can do, so it is posted through an App Proxy."
      },
      {
        "type": "text",
        "id": "inquiry_proxy_path",
        "label": "App Proxy path",
        "info": "Where the inquiry form posts. Must match the proxy configured on the app.",
        "default": "/apps/inquiry"
      },
      {
        "type": "paragraph",
        "content": "The per-item maximum is 999, matching MAX_QTY in the Next build. It is not a setting: assets/sb-inquiry-cart.js and lib/inquiry/schema.ts have to agree on it, and a theme control could only make them disagree."
      }
    ]
  }
]
